{% extends 'base.html.twig' %}

{% block title %}Entrée en Stock (Réception){% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# En-tête #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="ri-download-cloud-2-line me-2 text-success"></i>
                Entrée en Stock (Réception)
            </h2>
            <p class="text-muted mb-0">Ajouter des consommables ou médicaments au stock de la pharmacie interne.</p>
        </div>
        <a href="{{ path('app_pharmacie_index') }}" class="btn btn-outline-secondary">
            <i class=\"ri-arrow-left-line me-1\"></i> Retour pharmacie
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold text-dark mb-0">Nouveau mouvement d'entrée</h5>
                </div>
                
                <div class="card-body p-4">
                    {{ form_start(form) }}
                    
                    <div class="row g-4">
                        {# Bloc 1 : Identification du produit #}
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <h6 class="text-muted text-uppercase small fw-bold mb-3">Identification du produit</h6>
                                <div class="mb-3">
                                    {{ form_label(form.medicament, null, {'label_attr': {'class': 'fw-semibold'}}) }}
                                    {{ form_widget(form.medicament) }}
                                    {{ form_errors(form.medicament) }}
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        {{ form_label(form.numeroLot, null, {'label_attr': {'class': 'fw-semibold'}}) }}
                                        {{ form_widget(form.numeroLot) }}
                                        <div class="form-text small">Laissez vide si le produit n'a pas de lot spécifique.</div>
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_label(form.datePeremption, null, {'label_attr': {'class': 'fw-semibold'}}) }}
                                        {{ form_widget(form.datePeremption) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Bloc 2 : Quantité et Valorisation #}
                        <div class="col-12">
                            <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle">
                                <h6 class="text-success text-uppercase small fw-bold mb-3">Détails de la réception</h6>
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-6">
                                        {{ form_label(form.quantite, null, {'label_attr': {'class': 'fw-semibold'}}) }}
                                        {{ form_widget(form.quantite) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_label(form.prixAchat, null, {'label_attr': {'class': 'fw-semibold'}}) }}
                                        <div class="input-group shadow-sm">
                                            {{ form_widget(form.prixAchat) }}
                                            <span class="input-group-text bg-white fw-bold">FCFA</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="reset" class="btn btn-light px-4">Effacer</button>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="ri-check-line me-1"></i> Valider la réception
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
            
            <div class="alert alert-info mt-4 d-flex align-items-center" role="alert">
                <i class="ri-information-line fs-4 me-3"></i>
                <div>
                    <strong>Rappel Comptabilité Matière :</strong> Le prix d'achat saisi ici servira de base de calcul pour valoriser votre stock et générer vos rapports de consommation en fin de mois.
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}