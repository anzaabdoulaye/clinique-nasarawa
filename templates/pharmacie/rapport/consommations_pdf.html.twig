{# templates/pharmacie/rapport/consommations_pdf.html.twig #}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport de Consommations</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: sans-serif; font-size: 11px; color: #333; padding: 20px; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #0d6efd; padding-bottom: 15px; }
        .header h1 { font-size: 18px; color: #0d6efd; margin-bottom: 4px; text-transform: uppercase; }
        .header p { font-size: 11px; color: #666; }
        .kpi-row { display: table; width: 100%; margin-bottom: 15px; }
        .kpi { display: table-cell; text-align: center; padding: 8px; border: 1px solid #dee2e6; }
        .kpi .label { font-size: 9px; color: #888; text-transform: uppercase; }
        .kpi .value { font-size: 16px; font-weight: bold; color: #0d6efd; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 8px; border: 1px solid #dee2e6; text-align: left; }
        th { background-color: #f8f9fa; font-size: 10px; text-transform: uppercase; color: #555; }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .fw-bold { font-weight: bold; }
        .text-primary { color: #0d6efd; }
        .footer { margin-top: 30px; font-size: 9px; color: #999; text-align: center; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>

<div class="header">
    {% if logo_path %}
        <img src="{{ logo_path }}" alt="Logo" style="max-height: 100px; margin-bottom: 10px;">
    {% endif %}
    <h1>Rapport de Consommations (PUI)</h1>
    <p>Période du <strong>{{ date_debut|date('d/m/Y') }}</strong> au <strong>{{ date_fin|date('d/m/Y') }}</strong></p>
    <p>Généré le {{ 'now'|date('d/m/Y à H:i') }}</p>
</div>

{% set start = date(date_debut) %}
{% set end = date(date_fin) %}
{% set nbJours = start.diff(end).days + 1 %}

{% set maxQuantite = 0 %}
{% set topProduit = 'Aucun' %}
{% for r in resultats %}
    {% if r.quantite_consommee > maxQuantite %}
        {% set maxQuantite = r.quantite_consommee %}
        {% set topProduit = r.medicament_nom %}
    {% endif %}
{% endfor %}

<div class="kpi-row">
    <div class="kpi" style="width: 25%;">
        <div class="label">Volume Global</div>
        <div class="value">{{ totaux.total_quantite }}</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none;">
        <div class="label">Période</div>
        <div class="value">{{ nbJours }} Jours</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none; background-color: #fff8e6; border-color: #ffc107;">
        <div class="label" style="color: #b38600;">Top Produit</div>
        <div class="value" style="color: #b38600; font-size: 11px;">{{ topProduit }}</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none;">
        <div class="label">Valeur Consommée</div>
        <div class="value" style="color: #dc3545;">{{ totaux.total_valeur|number_format(0, ',', ' ') }} F</div>
    </div>
</div>

<table>
    <thead>
        <tr>
            <th style="width: 5%;">#</th>
            <th style="width: 30%;">Consommable</th>
            <th style="width: 15%;">Code</th>
            <th class="text-center" style="width: 10%;">Mvts</th>
            <th class="text-center" style="width: 10%;">Qté Totale</th>
            <th class="text-center" style="width: 15%;">Moy. / Jour</th>
            <th class="text-end" style="width: 15%;">Valeur</th>
        </tr>
    </thead>
    <tbody>
        {% for r in resultats %}
            <tr>
                <td>{{ loop.index }}</td>
                <td class="fw-bold">{{ r.medicament_nom }}</td>
                <td>{{ r.sku ?? '—' }}</td>
                <td class="text-center">{{ r.nb_mouvements }}</td>
                <td class="text-center fw-bold text-primary">{{ r.quantite_consommee }}</td>
                <td class="text-center">
                    {{ (r.quantite_consommee / nbJours)|number_format(1, ',', ' ') }}
                </td>
                <td class="text-end fw-bold">{{ r.valeur_totale|number_format(0, ',', ' ') }} F</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="fw-bold">TOTAL GÉNÉRAL</td>
            <td class="text-center fw-bold">{{ totaux.nb_mouvements }}</td>
            <td class="text-center fw-bold text-primary">{{ totaux.total_quantite }}</td>
            <td class="text-center fw-bold">{{ (totaux.total_quantite / nbJours)|number_format(1, ',', ' ') }}</td>
            <td class="text-end fw-bold" style="color: #dc3545;">{{ totaux.total_valeur|number_format(0, ',', ' ') }} F</td>
        </tr>
    </tfoot>
</table>

<div class="footer">
    Clinique Nassarawa — Ce rapport liste les sorties de stock valorisées au coût d'achat.
</div>

</body>
</html>