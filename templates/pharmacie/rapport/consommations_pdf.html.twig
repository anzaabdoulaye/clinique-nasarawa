{# templates/pharmacie/rapport/consommations_pdf.html.twig #}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport de Consommations</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: sans-serif; font-size: 11px; color: #333; padding: 20px; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #0d6efd; padding-bottom: 15px; }
        .header h1 { font-size: 18px; color: #0d6efd; margin-bottom: 4px; text-transform: uppercase; }
        .header p { font-size: 11px; color: #666; }
        .kpi-row { display: table; width: 100%; margin-bottom: 15px; }
        .kpi { display: table-cell; text-align: center; padding: 8px; border: 1px solid #dee2e6; }
        .kpi .label { font-size: 9px; color: #888; text-transform: uppercase; }
        .kpi .value { font-size: 16px; font-weight: bold; color: #0d6efd; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 8px; border: 1px solid #dee2e6; text-align: left; }
        th { background-color: #f8f9fa; font-size: 10px; text-transform: uppercase; color: #555; }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .fw-bold { font-weight: bold; }
        .text-primary { color: #0d6efd; }
        .footer { margin-top: 30px; font-size: 9px; color: #999; text-align: center; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>

<div class="header">
    {% if logo_path %}
        <img src="{{ logo_path }}" alt="Logo" style="max-height: 100px; margin-bottom: 10px;">
    {% endif %}
    <h1>Rapport de Consommations (PUI)</h1>
    <p>Période du <strong>{{ date_debut|date('d/m/Y') }}</strong> au <strong>{{ date_fin|date('d/m/Y') }}</strong></p>
    <p>Généré le {{ 'now'|date('d/m/Y à H:i') }}</p>
</div>

{% set start = date(date_debut) %}
{% set end = date(date_fin) %}
{% set nbJours = start.diff(end).days + 1 %}

{% set maxQuantite = 0 %}
{% set topProduit = 'Aucun' %}
{% for r in resultats %}
    {% if r.quantite_consommee > maxQuantite %}
        {% set maxQuantite = r.quantite_consommee %}
        {% set topProduit = r.medicament_nom %}
    {% endif %}
{% endfor %}

<div class="kpi-row">
    <div class="kpi" style="width: 25%;">
        <div class="label">Volume Global</div>
        <div class="value">{{ totaux.total_quantite }}</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none;">
        <div class="label">Période</div>
        <div class="value">{{ nbJours }} Jours</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none; background-color: #fff8e6; border-color: #ffc107;">
        <div class="label" style="color: #b38600;">Top Produit</div>
        <div class="value" style="color: #b38600; font-size: 11px;">{{ topProduit }}</div>
    </div>
    <div class="kpi" style="width: 25%; border-left: none;">
        <div class="label">Valeur Consommée</div>
        <div class="value" style="color: #dc3545;">{{ totaux.total_valeur|number_format(0, ',', ' ') }} F</div>
    </div>
</div>

<table>
    <thead>
        <tr>
            <th style="width:5%;">#</th>
            <th style="width:20%;">Consommable</th>
            <th class="text-center" style="width:8%;">Mvts</th>
            <th class="text-center" style="width:10%;">Qté</th>
            <th class="text-center" style="width:10%;">Moy/j</th>
            <th class="text-center" style="width:8%;">Stock</th>
            <th class="text-center" style="width:10%;">Couverture</th>
            <th class="text-center" style="width:8%;">Statut</th>
            <th class="text-end" style="width:11%;">Valeur</th>
        </tr>
    </thead>
    <tbody>
        {% for r in resultats %}
            <tr>
                <td>{{ loop.index }}</td>
                <td class="fw-bold">{{ r.medicament_nom }}</td>
                <td class="text-center">{{ r.nb_mouvements }}</td>
                <td class="text-center fw-bold text-primary">{{ r.quantite_consommee }}</td>
                <td class="text-center">{{ (r.quantite_consommee / nbJours)|number_format(1, ',', ' ') }}</td>
                <td class="text-center">{{ r.stock_actuel }}</td>
                <td class="text-center">
    {% if r.jours_couverture is same as(constant('INF')) %}∞{% else %}{{ r.jours_couverture }}{% endif %}
</td>
                <td class="text-center">
                    {% if r.statut == 'URGENT' %}Urgent
                    {% elseif r.statut == 'PRÉVOIR' %}Prévoir
                    {% else %}OK{% endif %}
                </td>
                <td class="text-end fw-bold">{{ r.valeur_totale|number_format(0, ',', ' ') }} F</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="6" class="fw-bold">TOTAL GÉNÉRAL</td>
            <td></td><td></td><td></td>
            <td class="text-end fw-bold" style="color: #dc3545;">{{ totaux.total_valeur|number_format(0, ',', ' ') }} F</td>
        </tr>
    </tfoot>
</table>
<div style="margin-top: 30px; border-top: 1px solid #eee; padding-top: 15px;">
    <h3 style="font-size: 12px; color: #0d6efd; margin-bottom: 8px;">Légende des statuts</h3>
    <table style="width: 100%; border: none; font-size: 10px;">
        <tr>
            <td style="border: none; padding: 4px; width: 20%;"><span style="background: #dc3545; color: white; padding: 2px 10px; border-radius: 3px;">Urgent</span></td>
            <td style="border: none; padding: 4px;">Stock ≤ seuil ou couverture &lt; 15 jours</td>
        </tr>
        <tr>
            <td style="border: none; padding: 4px;"><span style="background: #ffc107; color: #000; padding: 2px 10px; border-radius: 3px;">Prévoir</span></td>
            <td style="border: none; padding: 4px;">Couverture entre 15 et 29 jours</td>
        </tr>
        <tr>
            <td style="border: none; padding: 4px;"><span style="background: #198754; color: white; padding: 2px 10px; border-radius: 3px;">Suffisant</span></td>
            <td style="border: none; padding: 4px;">Couverture ≥ 30 jours et stock &gt; seuil</td>
        </tr>
    </table>
</div>

<div style="margin-top: 15px; background: #f8f9fa; padding: 12px; border-radius: 5px; font-size: 10px; color: #555;">
    <strong style="color: #333;">Note explicative :</strong>
    <ul style="margin: 5px 0 0 20px; padding-left: 10px;">
        <li><strong>Stock actuel</strong> : quantité totale disponible (somme des lots).</li>
        <li><strong>Couverture (j)</strong> : nombre de jours que le stock actuel peut couvrir, basé sur la consommation moyenne journalière.</li>
        <li><strong>Seuil d'alerte</strong> : seuil défini par produit (si renseigné).</li>
        <li><strong>Valeur</strong> : coût d'achat total des produits consommés sur la période.</li>
    </ul>
</div>

<div class="footer">
    Clinique Nassarawa — Ce rapport liste les sorties de stock valorisées au coût d'achat.
</div>

</body>
</html>