{# templates/pharmacie/rapport/consommations.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Rapport de Consommations{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# Header #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="ri-medicine-bottle-line me-2 text-primary"></i>
                Rapport de Consommations
            </h2>
            <p class="text-muted mb-0">Détail des consommations pharmacie sur la période sélectionnée.</p>
        </div>
        <a href="{{ path('app_rapport_pharmacie_index') }}" class="btn btn-outline-secondary">
            <i class="ri-arrow-left-line me-1"></i> Retour aux rapports
        </a>
    </div>

    {# Formulaire de sélection de période #}
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="GET" action="{{ path('app_rapport_pharmacie_consommations') }}" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="date_debut" class="form-label fw-semibold">Date début</label>
                    <input type="date" class="form-control bg-light" id="date_debut" name="date_debut" value="{{ date_debut ? date_debut|date('Y-m-d') : '' }}" required>
                </div>
                <div class="col-12 col-md-4">
                    <label for="date_fin" class="form-label fw-semibold">Date fin</label>
                    <input type="date" class="form-control bg-light" id="date_fin" name="date_fin" value="{{ date_fin ? date_fin|date('Y-m-d') : '' }}" required>
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="ri-search-line me-1"></i> Générer le rapport
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Résultats du rapport #}
    {% if resultats is not null %}
        
        {# --- LOGIQUE DE CALCUL TWIG --- #}
        {% set start = date(date_debut) %}
        {% set end = date(date_fin) %}
        {% set nbJours = start.diff(end).days + 1 %}
        
        {% set maxQuantite = 0 %}
        {% set topProduit = 'Aucun' %}
        {% for r in resultats %}
            {% if r.quantite_consommee > maxQuantite %}
                {% set maxQuantite = r.quantite_consommee %}
                {% set topProduit = r.medicament_nom %}
            {% endif %}
        {% endfor %}
        {# ------------------------------- #}

        {# Cartes KPI #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                        <small class="text-muted d-block mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Volume Global</small>
                        <h3 class="fw-bold text-dark mb-0">{{ totaux.total_quantite }}</h3>
                        <small class="text-muted">unités sorties</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                        <small class="text-muted d-block mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Période analysée</small>
                        <h3 class="fw-bold text-info mb-0">{{ nbJours }}</h3>
                        <small class="text-muted">jour(s)</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card border-0 shadow-sm border-warning rounded-4 h-100" style="border-width: 2px !important;">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center bg-warning-subtle">
                        <small class="text-warning-emphasis d-block mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Top Produit</small>
                        <h5 class="fw-bold text-dark mb-0 text-truncate" title="{{ topProduit }}">{{ topProduit }}</h5>
                        <small class="text-warning-emphasis fw-bold">{{ maxQuantite }} unités</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                        <small class="text-muted d-block mb-1 text-uppercase fw-bold" style="font-size: 0.75rem;">Valeur Consommée</small>
                        <h4 class="fw-bold text-danger mb-0">{{ totaux.total_valeur|number_format(0, ',', ' ') }}</h4>
                        <small class="text-muted">FCFA</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0 text-dark">
                    Détail des sorties ({{ date_debut|date('d/m/Y') }} — {{ date_fin|date('d/m/Y') }})
                </h5>
                <a href="{{ path('app_rapport_pharmacie_consommations_pdf', {date_debut: date_debut|date('Y-m-d'), date_fin: date_fin|date('Y-m-d')}) }}" 
                   class="btn btn-sm btn-danger" target="_blank">
                    <i class="ri-file-pdf-2-line me-1"></i> Exporter PDF
                </a>
            </div>
            
            <div class="card-body p-0">
                {% if resultats|length > 0 %}
                    <thead class="table-light">
    <tr>
        <th class="ps-4">#</th>
        <th>Consommable</th>
        <th>Code</th>
        <th class="text-center">Nb. Sorties</th>
        <th class="text-center text-primary">Qté Totale</th>
        <th class="text-center text-warning-emphasis" title="Moyenne par jour sur la période">Moy. / Jour</th>
        <th class="text-center">Stock actuel</th>
        <th class="text-center">Couverture (j)</th>
        <th class="text-center">Statut</th>
        <th class="text-end pe-4">Valeur (FCFA)</th>
    </tr>
</thead>
<tbody>
    {% for r in resultats %}
        <tr>
            <td class="ps-4 text-muted">{{ loop.index }}</td>
            <td class="fw-bold text-dark">{{ r.medicament_nom }}</td>
            <td><span class="badge bg-light text-dark border">{{ r.sku ?? '—' }}</span></td>
            <td class="text-center">{{ r.nb_mouvements }}</td>
            <td class="text-center fw-bold text-primary fs-6">{{ r.quantite_consommee }}</td>
            <td class="text-center">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                    {{ (r.quantite_consommee / nbJours)|number_format(1, ',', ' ') }}
                </span>
            </td>
            <td class="text-center">{{ r.stock_actuel }}</td>
            <td class="text-center">
    {% if r.jours_couverture is same as(constant('INF')) %}
        <span class="badge bg-secondary">∞</span>
    {% else %}
        {{ r.jours_couverture }}
    {% endif %}
</td>
            <td class="text-center">
                {% if r.statut == 'URGENT' %}
                    <span class="badge bg-danger">Urgent</span>
                {% elseif r.statut == 'PRÉVOIR' %}
                    <span class="badge bg-warning text-dark">Prévoir</span>
                {% else %}
                    <span class="badge bg-success">Suffisant</span>
                {% endif %}
            </td>
            <td class="text-end pe-4 fw-bold">{{ r.valeur_totale|number_format(0, ',', ' ') }} F</td>
        </tr>
    {% endfor %}
</tbody>
<tfoot class="table-light">
    <tr class="fw-bold text-dark">
        <td colspan="6" class="ps-4 text-uppercase">Total période</td>
        {# Cellules vides pour Stock, Couverture, Statut #}
        <td></td>
        <td></td>
        <td></td>
        <td class="text-end pe-4 text-danger fs-5">{{ totaux.total_valeur|number_format(0, ',', ' ') }} F</td>
    </tr>
</tfoot>
                {% else %}
                    <div class="text-center py-5">
                        <i class="ri-medicine-bottle-line fs-1 text-muted"></i>
                        <h5 class="fw-bold text-dark mt-3 mb-2">Aucune consommation sur cette période</h5>
                        <p class="text-muted">Aucune sortie de stock n'a été enregistrée entre ces deux dates.</p>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex justify-content-center align-items-center mb-3"
                 style="width: 70px; height: 70px;">
                <i class="ri-calendar-line fs-2 text-muted"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Sélectionnez une période</h5>
            <p class="text-muted">Choisissez les dates de début et fin pour générer le rapport de consommation.</p>
        </div>
    {% endif %}
</div>
{% endblock %}