{# templates/hospitalisation/print.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche d'Hospitalisation #{{ hospitalisation.id }}</title>
    <style>
        @page {
            size: A4 portrait;
            margin: 8mm 10mm;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            font-size: 9.5px;
            color: #1f2937;
            background: #ffffff;
        }

        .document { width: 100%; }

        .sheet {
            padding: 0;
            background: #ffffff;
        }

        .top-bar {
            height: 6px;
            background: #0f4c81; /* Fallback couleur unie pour Dompdf */
            margin-bottom: 8px;
            border-radius: 4px;
        }

        table { width: 100%; border-collapse: collapse; }
        td, th { vertical-align: top; }

        .clinic-logo {
            width: 20mm;
            height: 20mm;
            border: 1px solid #cfd8e3;
            padding: 2px;
            background: #ffffff;
            border-radius: 50%;
        }

        .clinic h1 {
            margin: 0 0 4px 0;
            font-size: 14px;
            font-weight: bold;
            color: #0f4c81;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .clinic .sub {
            font-size: 8px;
            line-height: 1.4;
            color: #4b5563;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            font-size: 9px;
            font-weight: bold;
            border: 1px solid #0f4c81;
            background: #eff6ff;
            color: #0f4c81;
            text-transform: uppercase;
            border-radius: 10px;
        }

        .separator {
            border-bottom: 1px solid #d7dee7;
            margin: 8px 0;
        }

        .title-box { text-align: center; margin-bottom: 10px; }
        .title-box .title {
            font-size: 13px;
            font-weight: bold;
            color: #0f4c81;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .title-box .subtitle {
            margin-top: 3px;
            font-size: 8px;
            color: #6b7280;
        }

        .meta-box, .box {
            border: 1px solid #d7dee7;
            border-radius: 4px;
        }

        .meta-box { background: #fbfdff; padding: 6px; margin-bottom: 10px; }
        .meta-table td { padding: 4px 5px; width: 50%; }

        .field-label {
            display: block;
            font-size: 8px;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 2px;
            font-weight: bold;
        }

        .field-value {
            display: block;
            font-size: 10px;
            font-weight: bold;
            color: #111827;
        }

        .section { margin-top: 10px; }
        .section-title {
            padding: 5px 7px;
            font-size: 10px;
            font-weight: bold;
            color: #0f4c81;
            background: #f5f9fc;
            border: 1px solid #d7dee7;
            border-bottom: none;
            text-transform: uppercase;
        }

        .box {
            padding: 8px;
            line-height: 1.45;
            background: #ffffff;
            border-top: none;
            border: 1px solid #d7dee7;
        }

        /* Dompdf compatible Grid alternatives */
        .layout-table td { padding: 4px 8px 8px 0; }
        .col-25 { width: 25%; }
        .col-33 { width: 33.33%; }
        .col-50 { width: 50%; }
        .col-100 { width: 100%; padding-bottom: 8px; }

        .text-content { font-size: 9.5px; font-weight: normal; color: #374151; }

        .data-table th, .data-table td {
            border: 1px solid #d7dee7;
            padding: 4px;
            text-align: center;
            font-size: 8.5px;
        }
        .data-table th { background: #f8fbfe; color: #0f4c81; font-weight: bold; }

        .signature-table { margin-top: 20px; }
        .signature-block { text-align: center; height: 60px; padding: 0 10px; }
        .signature-title { font-size: 9px; color: #6b7280; margin-bottom: 45px; font-weight: bold;}
        .line { border-top: 1px solid #000; padding-top: 4px; font-size: 8px; color: #6b7280; }

        .footer-note {
            margin-top: 15px;
            padding-top: 5px;
            text-align: center;
            font-size: 9px;
            font-weight: bold;
            color: #0f4c81;
            border-top: 1px dashed #d1d5db;
        }
    </style>
</head>
<body>

    {# Initialisation des variables #}
    {% set dossier = hospitalisation.dossierMedical %}
    {% set patient = dossier.patient %}
    {% set patientNom = patient ? ((patient.nom ?? '') ~ ' ' ~ (patient.prenom ?? ''))|trim : '—' %}
    {% set medecinNom = hospitalisation.medecinReferent ? (hospitalisation.medecinReferent.nom ~ ' ' ~ hospitalisation.medecinReferent.prenom) : '—' %}
    {% set dateAdmission = hospitalisation.dateAdmission ? hospitalisation.dateAdmission|date('d/m/Y H:i') : '—' %}
    {% set dateSortie = hospitalisation.dateSortie ? hospitalisation.dateSortie|date('d/m/Y H:i') : '—' %}
    {% set statut = hospitalisation.statut.value ?? hospitalisation.statut %}

    <div class="document">
        <div class="sheet">
            <div class="top-bar"></div>

            {# --- EN-TÊTE --- #}
            <table>
                <tr>
                    <td style="width:15%;">
                        <img src="{{ absolute_url(asset('assets/images/logo.jpeg')) }}" alt="Logo Clinique" class="clinic-logo">
                    </td>
                    <td style="width:60%;">
                        <div class="clinic">
                            <h1>Clinique Neurologique Nassarawa</h1>
                            <div class="sub">
                                <strong>NIF :</strong> 120402/R | <strong>RCCM :</strong> NE-NIM-01-2024-B12-00145<br>
                                <strong>Adresse :</strong> Yantala Haut, Avenue du Daoura YN 187, Niamey<br>
                                <strong>Tél :</strong> 20 75 51 02 / 82 09 61 12<br>
                                <strong>Email :</strong> nassrawaclinique@gmail.com
                            </div>
                        </div>
                    </td>
                    <td style="width:25%; text-align:right;">
                        </td>
                </tr>
            </table>

            <div class="separator"></div>

            <div class="title-box">
                <div class="title">Fiche d’hospitalisation</div>
                <div class="subtitle">Référence : HOSP-{{ hospitalisation.id }} | Imprimé le {{ "now"|date('d/m/Y H:i') }}</div>
            </div>

            {# --- INFOS PATIENT & SÉJOUR --- #}
            <div class="meta-box">
                <table class="meta-table">
                    <tr>
                        <td>
                            <span class="field-label">Patient</span>
                            <span class="field-value">{{ patientNom }}</span>
                        </td>
                        <td>
                            <span class="field-label">Dossier médical</span>
                            <span class="field-value">{{ dossier.numeroDossier }}</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-label">Médecin référent</span>
                            <span class="field-value">{{ medecinNom }}</span>
                        </td>
                        <td>
                            <span class="field-label">Date d’admission</span>
                            <span class="field-value">{{ dateAdmission }}</span>
                        </td>
                    </tr>
                </table>
            </div>

            {# --- ADMISSION & ANAMNÈSE --- #}
            <div class="section">
                <div class="section-title">Admission & Anamnèse</div>
                <div class="box">
                    <table class="layout-table">
                        <tr>
                            <td class="col-100">
                                <span class="field-label">Motif d'admission</span>
                                <span class="text-content">{{ hospitalisation.motifAdmission ?: '—' }}</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="col-100">
                                <span class="field-label">Histoire de la maladie</span>
                                <span class="text-content">{{ hospitalisation.histoireMaladie|nl2br ?: '—' }}</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            {# --- ANTÉCÉDENTS (JSON) --- #}
            <div class="section">
                <div class="section-title">Antécédents du patient</div>
                <div class="box">
                    <table class="layout-table">
                        <tr>
                            <td class="col-50">
                                <span class="field-label">Médicaux</span>
                                <span class="text-content">{{ dossier.antecedents.medicaux|default('—') }}</span>
                            </td>
                            <td class="col-50">
                                <span class="field-label">Chirurgicaux</span>
                                <span class="text-content">{{ dossier.antecedents.chirurgicaux|default('—') }}</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="col-50">
                                <span class="field-label">Gynéco-obstétricaux</span>
                                <span class="text-content">{{ dossier.antecedents.gyneco_obstetricaux|default('—') }}</span>
                            </td>
                            <td class="col-50">
                                <span class="field-label">Mode de vie / Autres</span>
                                <span class="text-content">{{ dossier.antecedents.mode_vie|default('—') }}</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            {# --- DIAGNOSTICS & BILAN PARACLINIQUE --- #}
            <div class="section">
                <div class="section-title">Bilan Paraclinique & Diagnostics</div>
                <div class="box">
                    <table class="layout-table">
                        <tr>
                            <td class="col-50">
                                <span class="field-label">Hypothèses Diagnostiques</span>
                                <span class="text-content">{{ hospitalisation.hypothesesDiagnostiques|nl2br ?: '—' }}</span>
                            </td>
                            <td class="col-50">
                                <span class="field-label">Diagnostic Positif Retenu</span>
                                <span class="field-value">{{ hospitalisation.diagnosticPositif|nl2br ?: 'En attente' }}</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="col-50">
                                <span class="field-label">Bilan Imagerie</span>
                                <span class="text-content">{{ hospitalisation.bilanParaclinique.imagerie|default('—')|nl2br }}</span>
                            </td>
                            <td class="col-50">
                                <span class="field-label">Bilan Biologie</span>
                                <span class="text-content">{{ hospitalisation.bilanParaclinique.biologie|default('—')|nl2br }}</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            {# --- SUIVI CLINIQUE (Constantes) --- #}
            <div class="section">
                <div class="section-title">Dernières Constantes (Suivi Clinique)</div>
                <div class="box" style="padding: 4px;">
                    <table class="data-table">
                        <tr>
                            <th>Date / Heure</th>
                            <th>Temp.</th>
                            <th>TA</th>
                            <th>Pouls</th>
                            <th>SaO2</th>
                            <th>Poids</th>
                            <th>Notes</th>
                        </tr>
                        {% for constante in hospitalisation.examensCliniques|sort((a, b) => b.datePrise <=> a.datePrise)|slice(0, 5) %}
                            <tr>
                                <td><strong>{{ constante.datePrise|date('d/m/Y H:i') }}</strong></td>
                                <td>{{ constante.temperature ? constante.temperature ~ '°C' : '-' }}</td>
                                <td>{{ constante.tensionArterielle ?: '-' }}</td>
                                <td>{{ constante.pouls ? constante.pouls ~ ' bpm' : '-' }}</td>
                                <td>{{ constante.saturationOxygene ? constante.saturationOxygene ~ '%' : '-' }}</td>
                                <td>{{ constante.poids ? constante.poids ~ ' kg' : '-' }}</td>
                                <td style="text-align: left;">{{ constante.notes ?: '-' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" style="padding: 10px;">Aucune constante enregistrée.</td></tr>
                        {% endfor %}
                    </table>
                </div>
            </div>

            {# --- PLAN DE TRAITEMENT --- #}
            <div class="section">
                <div class="section-title">Traitements prescrits</div>
                <div class="box" style="padding: 4px;">
                    <table class="data-table">
                        <tr>
                            <th style="text-align: left;">Description du traitement / Soin</th>
                            <th style="width: 25%;">Période</th>
                        </tr>
                        {% for traitement in hospitalisation.traitements %}
                            <tr>
                                <td style="text-align: left; font-weight: bold;">{{ traitement.description }}</td>
                                <td>
                                    {% if traitement.dateDebut %}Du {{ traitement.dateDebut|date('d/m/Y') }}{% endif %}
                                    {% if traitement.dateFin %} au {{ traitement.dateFin|date('d/m/Y') }}{% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="2" style="padding: 10px;">Aucun traitement prescrit.</td></tr>
                        {% endfor %}
                    </table>
                </div>
            </div>

            {# --- SIGNATURES --- #}
            <table class="signature-table">
                <tr>
                    <td class="signature-block col-33">
                        <div class="signature-title">Médecin Référent</div>
                        <div class="line">Signature / Cachet</div>
                    </td>
                    <td class="signature-block col-33">
                        <div class="signature-title">Infirmier(ère) Responsable</div>
                        <div class="line">Visa et Date</div>
                    </td>
                    <td class="signature-block col-33">
                        <div class="signature-title">Direction Médicale</div>
                        <div class="line">Visa et Cachet</div>
                    </td>
                </tr>
            </table>

            <div class="footer-note">
                Document médical confidentiel - Merci de conserver cette fiche dans le dossier du patient.
            </div>

        </div>
    </div>
</body>
</html>