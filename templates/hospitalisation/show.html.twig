{# templates/hospitalisation/show.html.twig.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hospitalisation #{{ hospitalisation.id }}{% endblock %}

{% block body %}
<style>
    /* ... tous les styles existants ... */
    .hs-wrap { max-width: 1100px; margin: 0 auto; }
    .hs-card { border: 1px solid rgba(0,0,0,.06); border-radius: 16px; background: #fff; }
    .hs-card .card-header { background: #fff; border-bottom: 1px solid rgba(0,0,0,.06); border-top-left-radius: 16px; border-top-right-radius: 16px; }
    .hs-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    @media (max-width: 768px) { .hs-kv { grid-template-columns: 1fr; } }
    .hs-field { border: 1px solid rgba(0,0,0,.06); border-radius: 14px; padding: 12px; background: #fff; }
    .hs-label { font-size: 11px; color: #6b7280; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px; }
    .hs-value { font-size: 14px; font-weight: 650; color: #111827; }
    .hs-section { border: 1px solid rgba(0,0,0,.06); border-radius: 16px; background: #fff; padding: 16px; margin-bottom: 20px; }
    .hs-section-title { font-weight: 800; font-size: 14px; color: #111827; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .hs-text { white-space: pre-line; color: #374151; font-size: 14px; line-height: 1.5; }
    .badge-soft { border: 1px solid rgba(0,0,0,.08); padding: .4rem .7rem; border-radius: 999px; font-weight: 700; font-size: 12px; }

    .table-soins th {
        font-size: 10px;
        background: #f9fafb;
        text-align: center;
        padding: 8px 4px;
    }

    .hour-cell {
        width: 40px;
        height: 40px;
        padding: 0 !important;
        vertical-align: middle;
        text-align: center;
        border: 1px solid #edf2f7;
    }

    .medic-col {
        width: 160px;
    }

    .medic-text {
        max-width: 160px;
        white-space: normal;
        word-break: break-word;
    }

    .scheduled-cell {
        background: #f3f4f6;
    }

    .hour-active {
        background-color: #0d6efd !important;
        color: #fff !important;
    }

    .hour-missed {
        background: #f8d7da !important;
    }

    .hour-upcoming {
        background: #fff3cd !important;
    }

    .hour-late {
        background: #fd7e14 !important;
        color: #fff !important;
    }

    .admin-cell-btn {
        width: 100%;
        height: 100%;
        min-height: 40px;
        border: none;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }

    .admin-cell-btn:hover {
        background: rgba(13, 110, 253, 0.08);
    }

    .admin-cell-btn:disabled {
        cursor: not-allowed;
        opacity: .55;
    }

    .admin-cell-btn:disabled:hover {
        background: transparent;
    }

    .hour-active .admin-cell-btn:hover {
        background: transparent;
    }

    .admin-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #6c757d;
        display: inline-block;
    }

    .alert-strip {
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .alert-strip-danger {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f1aeb5;
    }

    .alert-strip-warning {
        background: #fff3cd;
        color: #664d03;
        border: 1px solid #ffecb5;
    }

    .badge-alert {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        margin-top: 6px;
        margin-right: 4px;
    }

    .badge-alert-info {
        background: #e7f1ff;
        color: #0a58ca;
    }

    .badge-alert-warning {
        background: #fff3cd;
        color: #997404;
    }

    .badge-alert-danger {
        background: #f8d7da;
        color: #842029;
    }

    .treatment-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }
</style>

{# templates/hospitalisation/show.html.twig.html.twig #}

{# Initialisation des variables #}
{% set statut = hospitalisation.statut.value ?? hospitalisation.statut %}
{% set patient = hospitalisation.dossierMedical.patient ?? null %}
{% set today = "now"|date("Y-m-d", "Africa/Niamey") %}
{% set nowTs = "now"|date("U") %}
{% set missedCount = 0 %}
{% set endingTodayCount = 0 %}
{% set canRemoveAdministration = is_granted('ROLE_MEDECIN') or is_granted('ROLE_ADMIN') %}
{% set canDeleteTreatment = is_granted('ROLE_ADMIN') %}

{# Calcul des traitements se terminant aujourd'hui et des administrations manquées #}
{% for t in hospitalisation.traitements %}
    {% if t.dateFin and t.dateFin|date("Y-m-d") == today %}
        {% set endingTodayCount = endingTodayCount + 1 %}
    {% endif %}

    {% if t.dateDebut and t.dateFin and t.dateDebut|date("Y-m-d") <= today and t.dateFin|date("Y-m-d") >= today %}
        {# Utiliser la planification si disponible, sinon fallback #}
        {% set heuresDuJour = t.getHeuresPourDate("now"|date_modify("midnight")) %}
        {% for h in heuresDuJour %}
            {% set deadlineTs = (today ~ ' ' ~ '%02d'|format(h) ~ ':00:00')|date_modify('+1 hour')|date('U') %}
            {% if deadlineTs <= nowTs and not t.isAdministeredAt("now"|date_modify("midnight"), h) %}
                {% set missedCount = missedCount + 1 %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endfor %}

<div class="hs-wrap mt-4">
    {# ====== ENTÊTE ====== #}
    <div class="card hs-card shadow-sm border-0 mb-4">
        <div class="card-header py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="fa fa-procedures me-2 text-primary"></i>
                        Hospitalisation #{{ hospitalisation.id }}
                    </h5>
                    <small class="text-muted">
                        Patient : <strong>{{ patient ? patient.nom|upper ~ ' ' ~ patient.prenom : 'Non défini' }}</strong>
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <span class="badge-soft {{ statut in ['TERMINE','SORTIE'] ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' }}">
                        {{ statut|upper }}
                    </span>
                    <a href="{{ path('app_hospitalisation_index') }}" class="btn btn-light border btn-sm">
                        <i class="fa fa-arrow-left me-1"></i> Retour
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                    <button type="button" class="btn btn-outline-primary btn-sm js-ajax-modal" 
                            data-url="{{ path('app_hospitalisation_edit', {'id': hospitalisation.id}) }}"
                            data-title="Modifier l'hospitalisation">
                        <i class="fa fa-pen me-1"></i> Modifier
                    </button>
                {% endif %}
                    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                        <i class="fa fa-print me-1"></i> Imprimer
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="hs-kv mb-4">
                <div class="hs-field">
                    <div class="hs-label">Dossier Médical</div>
                    <div class="hs-value">{{ hospitalisation.dossierMedical.numeroDossier ?? 'N/A' }}</div>
                </div>
                <div class="hs-field">
                    <div class="hs-label">Médecin Référent</div>
                    <div class="hs-value">{{ hospitalisation.medecinReferent ? hospitalisation.medecinReferent.nom ~ '  ' ~ hospitalisation.medecinReferent.prenom : 'Non assigné' }}</div>
                </div>
                <div class="hs-field">
                    <div class="hs-label">Date Admission</div>
                    <div class="hs-value text-primary">{{ hospitalisation.dateAdmission ? hospitalisation.dateAdmission|date('d/m/Y H:i') : '—' }}</div>
                </div>
                <div class="hs-field">
                    <div class="hs-label">Date Sortie Prévue / Effective</div>
                    <div class="hs-value">{{ hospitalisation.dateSortie ? hospitalisation.dateSortie|date('d/m/Y H:i') : 'En cours' }}</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <div class="hs-section">
                        <div class="hs-section-title"><i class="fa fa-clipboard-list text-primary"></i> Motif d'admission</div>
                        <div class="hs-text">{{ hospitalisation.motifAdmission ?: 'Aucun motif renseigné.' }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="hs-section h-100">
                        <div class="hs-section-title"><i class="fa fa-notes-medical text-primary"></i> Histoire de la maladie</div>
                        <div class="hs-text">{{ hospitalisation.histoireMaladie ?: '—' }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="hs-section h-100">
                        <div class="hs-section-title"><i class="fa fa-chart-line text-primary"></i> Évolution</div>
                        <div class="hs-text">{{ hospitalisation.evolution ?: '—' }}</div>
                    </div>
                </div>
            </div>

            {# ====== ANTÉCÉDENTS DU PATIENT ====== #}
    <div class="hs-section shadow-sm mb-4">
        <div class="hs-section-title d-flex justify-content-between align-items-center mb-3">
            <span><i class="fa fa-history text-primary"></i> Antécédents (Dossier Médical)</span>
{% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_dossier_medical_edit', { 'id': hospitalisation.dossierMedical.id, 'redirect_to': path('app_hospitalisation_show', {'id': hospitalisation.id}) }) }}" class="btn btn-sm btn-light border">
                    <i class="fa fa-external-link-alt me-1"></i> Modifier le dossier
                </a>
            {% endif %}
        </div>
        <div class="row g-3 small">
            <div class="col-md-3">
                <span class="text-muted d-block fw-bold mb-1">Médicaux</span>
                <span class="text-dark">{{ hospitalisation.dossierMedical.antecedents.medicaux | default('—') }}</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block fw-bold mb-1">Chirurgicaux</span>
                <span class="text-dark">{{ hospitalisation.dossierMedical.antecedents.chirurgicaux | default('—') }}</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block fw-bold mb-1">Gynéco-obst.</span>
                <span class="text-dark">{{ hospitalisation.dossierMedical.antecedents.gyneco_obstetricaux | default('—') }}</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block fw-bold mb-1">Mode de vie</span>
                <span class="text-dark">{{ hospitalisation.dossierMedical.antecedents.mode_vie | default('—') }}</span>
            </div>
        </div>
    </div>
            {# ====== BILAN ET DIAGNOSTICS ====== #}
    <div class="hs-section shadow-sm mb-4">
        <div class="hs-section-title d-flex justify-content-between align-items-center mb-3">
            <span><i class="fa fa-stethoscope text-primary"></i> Diagnostics & Bilan Paraclinique</span>
           {% if is_granted('ROLE_ADMIN') %}
                <button type="button" class="btn btn-sm btn-outline-primary js-ajax-modal"
                        data-url="{{ path('app_hospitalisation_edit_bilan', {'id': hospitalisation.id}) }}"
                        data-title="Mettre à jour le Bilan">
                    <i class="fa fa-pen me-1"></i> Compléter
                </button>
            {% endif %}
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 bg-light border rounded h-100">
                    <h6 class="fw-bold text-muted mb-2 small text-uppercase">Hypothèses diagnostiques</h6>
                    <div class="text-dark small" style="white-space: pre-line;">{{ hospitalisation.hypothesesDiagnostiques ?: 'Aucune hypothèse renseignée.' }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-primary-subtle border border-primary-subtle rounded h-100">
                    <h6 class="fw-bold text-primary mb-2 small text-uppercase">Diagnostic Positif Retenu</h6>
                    <div class="text-dark fw-medium small" style="white-space: pre-line;">{{ hospitalisation.diagnosticPositif ?: 'En attente de diagnostic.' }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded h-100">
                    <h6 class="fw-bold text-muted mb-2 small text-uppercase">Bilan Imagerie</h6>
                    <div class="text-dark small" style="white-space: pre-line;">{{ hospitalisation.bilanParaclinique.imagerie ?? 'Aucun résultat d\'imagerie.' }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded h-100">
                    <h6 class="fw-bold text-muted mb-2 small text-uppercase">Bilan Biologie</h6>
                    <div class="text-dark small" style="white-space: pre-line;">{{ hospitalisation.bilanParaclinique.biologie ?? 'Aucun résultat biologique.' }}</div>
                </div>
            </div>
        </div>
    </div>
        </div>
    </div>

    {# ====== FIL D'ACTUALITÉ / NOTES D'ÉVOLUTION ====== #}
            <div class="hs-section shadow-sm mb-4" style="border-top: 4px solid var(--bs-primary);">
                <div class="hs-section-title d-flex justify-content-between align-items-center mb-3">
                    <span><i class="fas fa-stream text-primary"></i> Fil d'actualité du séjour</span>
                    {% if is_granted('ROLE_MEDECIN') or is_granted('ROLE_ADMIN') %}
                        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseObservationForm" aria-expanded="false">
                            <i class="fas fa-plus me-1"></i> Ajouter une note
                        </button>
                    {% endif %}
                </div>

                {# Formulaire d'ajout (Caché par défaut via Collapse) #}
                <div class="collapse mb-4" id="collapseObservationForm">
                    <div class="card card-body bg-light border-0 shadow-sm p-3">
                        <h6 class="fw-bold mb-3">Nouvelle note d'évolution</h6>
                        {% if formObservation is defined %}
                            {{ form_start(formObservation) }}
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        {{ form_row(formObservation.typeObservation) }}
                                    </div>
                                    <div class="col-md-8">
                                        {{ form_row(formObservation.contenu) }}
                                    </div>
                                    <div class="col-12 text-end mt-2">
                                        <button type="submit" class="btn btn-success fw-bold">
                                            <i class="fas fa-save me-1"></i> Enregistrer
                                        </button>
                                    </div>
                                </div>
                            {{ form_end(formObservation) }}
                        {% endif %}
                    </div>
                </div>

                {# Timeline spécifique à cette hospitalisation #}
                <div class="timeline-container mt-2">
                    {# Magie Twig : On filtre pour n'afficher QUE les observations liées à CETTE hospitalisation #}
                    {% set current_observations = hospitalisation.dossierMedical.observations|filter(o => o.hospitalisation and o.hospitalisation.id == hospitalisation.id)|sort((a, b) => b.createdAt <=> a.createdAt) %}
                    
                    {% if current_observations is empty %}
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-notes-medical fs-2 mb-2 opacity-50"></i>
                            <p class="mb-0">Aucune note n'a encore été ajoutée pour ce séjour.</p>
                        </div>
                    {% else %}
                        <div class="position-relative ps-4 border-start border-2 border-primary border-opacity-25 ms-2">
                            {% for observation in current_observations %}
                                <div class="mb-4 position-relative">
                                    {# Le point sur la ligne du temps #}
                                    <div class="position-absolute bg-primary rounded-circle" style="width: 14px; height: 14px; left: -32px; top: 5px; border: 3px solid white; box-shadow: 0 0 0 1px var(--bs-primary);"></div>
                                    
                                    <div class="card border-0 bg-light shadow-sm">
                                        <div class="card-body p-3">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                                <span class="badge bg-primary">{{ observation.typeObservation }}</span>
                                                <small class="text-muted fw-semibold">
                                                    <i class="fas fa-clock me-1"></i> {{ observation.createdAt|date('d/m/Y à H:i') }}
                                                </small>
                                            </div>
                                            
                                            <p class="mb-2 text-dark" style="white-space: pre-line;">{{ observation.contenu }}</p>
                                            
                                            <div class="text-end border-top pt-2 mt-2">
                                                <small class="text-muted fw-bold">
                                                    <i class="fas fa-user-md me-1"></i> Dr. {{ observation.medecinAuteur.nom }} {{ observation.medecinAuteur.prenom }}
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
{# ====== CONSTANTES & EXAMENS CLINIQUES ====== #}
    <div class="hs-section shadow-sm mb-4">
        <div class="hs-section-title d-flex justify-content-between align-items-center mb-3">
            <span><i class="fa fa-heartbeat text-danger"></i> Constantes & Suivi Clinique</span>
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEDECIN') or is_granted('ROLE_INFIRMIER') %}
                <button type="button" class="btn btn-sm btn-outline-danger js-ajax-modal"
                        data-url="{{ path('app_hospitalisation_add_constantes', {'id': hospitalisation.id}) }}"
                        data-title="Nouvelle prise de constantes">
                    <i class="fa fa-plus me-1"></i> Ajouter
                </button>
            {% endif %}
        </div>
        
        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered align-middle text-center small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Heure</th>
                        <th>Temp.</th>
                        <th>TA</th>
                        <th>Pouls</th>
                        <th>SaO2</th>
                        <th>Poids</th>
                        <th>Signes</th>
                        <th class="text-start">Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {# On trie pour avoir la plus récente en haut #}
                    {% for constante in hospitalisation.examensCliniques|sort((a, b) => b.datePrise <=> a.datePrise) %}
                        <tr>
                            <td class="fw-bold text-nowrap">{{ constante.datePrise|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if constante.temperature %}
                                    <span class="{{ constante.temperature > 38 ? 'text-danger fw-bold' : '' }}">{{ constante.temperature }} °C</span>
                                {% else %}-{% endif %}
                            </td>
                            <td>{{ constante.tensionArterielle ?: '-' }}</td>
                            <td>{{ constante.pouls ? constante.pouls ~ ' bpm' : '-' }}</td>
                            <td>{{ constante.saturationOxygene ? constante.saturationOxygene ~ ' %' : '-' }}</td>
                            <td>{{ constante.poids ? constante.poids ~ ' kg' : '-' }}</td>
                            <td>
                                {% if constante.deshydratation %}<span class="badge bg-warning text-dark me-1">Déshydr.</span>{% endif %}
                                {% if constante.oedeme %}<span class="badge bg-info text-dark">Œdème</span>{% endif %}
                            </td>
                            <td class="text-start">{{ constante.notes ?: '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-muted py-4 text-center">Aucune constante enregistrée pour le moment.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {# ====== PLAN DE TRAITEMENT (FEUILLE DE SOINS) ====== #}
    <div class="hs-section shadow-sm">
        <div class="hs-section-title d-flex justify-content-between align-items-center">
            <span><i class="fa fa-pills text-primary"></i> Plan de Traitement / Feuille de Soins</span>
            <button type="button" class="btn btn-sm btn-primary js-ajax-modal"
                    data-url="{{ path('app_traitement_hospitalisation_new', {'hospitalisation': hospitalisation.id}) }}"
                    data-title="Ajouter un nouveau traitement">
                <i class="fa fa-plus me-1"></i> Ajouter un traitement
            </button>
        </div>

        {% if missedCount > 0 %}
            <div class="alert-strip alert-strip-danger">
                ⚠ {{ missedCount }} administration(s) manquée(s) aujourd’hui.
            </div>
        {% endif %}

        {% if endingTodayCount > 0 %}
            <div class="alert-strip alert-strip-warning">
                ⏳ {{ endingTodayCount }} traitement(s) se termine(nt) aujourd’hui.
            </div>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-bordered align-middle table-soins">
                <thead>
                    <tr>
                        <th class="text-start medic-col">Consommable / Soin</th>
                        <th style="min-width: 100px;">Période</th>
                        {% for h in 0..23 %}
                            <th class="hour-cell">{{ h }}h</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody id="traitements-list">
                    {% for traitement in hospitalisation.traitements %}
                        {% include 'hospitalisation/_traitement_rows.html.twig' with {
                            traitement: traitement,
                            today: today,
                            nowTs: nowTs,
                            canRemoveAdministration: canRemoveAdministration,
                            canDeleteTreatment: canDeleteTreatment
                        } only %}
                    {% else %}
                        <tr>
                            <td colspan="26" class="text-center py-4 text-muted small">
                                Aucun traitement enregistré.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Modals #}
<div class="modal fade" id="ajaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="ajaxModalTitle">Chargement...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="ajaxModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="lateReasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="lateReasonForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Justification du retard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-0">
                        <label for="lateReasonObservation" class="form-label fw-semibold">Explication obligatoire</label>
                        <textarea id="lateReasonObservation" class="form-control" rows="4" 
                                  placeholder="Précisez pourquoi ce traitement est administré en retard..." required></textarea>
                        <div class="form-text">Cette justification sera enregistrée avec l’administration du traitement.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-clock me-1"></i> Enregistrer le retard
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/traitement-form.js') }}"></script>
     <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ========== MODAL AJAX ==========
            const modalElement = document.getElementById('ajaxModal');
            const modalBody = document.getElementById('ajaxModalBody');
            const modalTitle = document.getElementById('ajaxModalTitle');
            if (!modalElement || !modalBody || !modalTitle) return;

            const ajaxModal = new bootstrap.Modal(modalElement);
            const xhrHeaders = { 'X-Requested-With': 'XMLHttpRequest' };

            function bindAjaxForm(form) {
                if (!form) return;
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;

                    const action = form.getAttribute('action') || window.location.href;
                    const formData = new FormData(form);

                    try {
                        const response = await fetch(action, {
                            method: 'POST',
                            body: formData,
                            headers: xhrHeaders
                        });
                        const data = await response.json();

                        if (data.success) {
                            ajaxModal.hide();
                            if (data.html) {
                                const tbody = document.getElementById('traitements-list');
                                if (data.traitementId) {
                                    const existingRows = tbody.querySelectorAll(`tr[data-traitement-id="${data.traitementId}"]`);
                                    existingRows.forEach(row => row.remove());
                                }
                                tbody.insertAdjacentHTML('beforeend', data.html);
                            } else {
                                window.location.reload();
                            }
                        } else {
                            if (data.form) {
                                modalBody.innerHTML = data.form;
                                bindAjaxForm(modalBody.querySelector('form'));
                                if (typeof initTraitementForm === 'function') {
                                    initTraitementForm();
                                }
                            } else {
                                alert(data.errors ? data.errors.join('\n') : 'Erreur lors de l\'enregistrement');
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Erreur serveur.');
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            }

           // Ouverture du modal
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.js-ajax-modal');
                if (!btn) return;
                e.preventDefault();

                const url = btn.dataset.url;
                const title = btn.dataset.title || 'Formulaire';
                modalTitle.textContent = title;
                modalBody.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
                ajaxModal.show();

                try {
                    const response = await fetch(url, { method: 'GET', headers: xhrHeaders });
                    
                    // 1. On lit la réponse brute en TEXTE
                    const text = await response.text(); 
                    
                    try {
                        // 2. On essaie de la convertir en JSON
                        const data = JSON.parse(text); 
                        if (data.form) {
                            modalBody.innerHTML = data.form;
                            if (typeof initTraitementForm === 'function') {
                                initTraitementForm();
                            }
                            bindAjaxForm(modalBody.querySelector('form'));
                        } else if (data.error) {
                            modalBody.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                        } else {
                            modalBody.innerHTML = '<div class="alert alert-danger">Impossible de charger le formulaire.</div>';
                        }
                    } catch (jsonError) {
                        // 3. LA MAGIE : Si ce n'est pas du JSON, c'est l'erreur 500 de Symfony !
                        // On l'affiche directement dans la modale pour pouvoir la lire.
                        modalBody.innerHTML = text; 
                    }
                } catch (error) {
                    console.error(error);
                    modalBody.innerHTML = '<div class="alert alert-danger">Erreur de chargement.</div>';
                }
            });

            // ========== ADMINISTRATION TOGGLE ==========
            // (Assurez-vous de n'avoir qu'un seul bloc de ce code dans votre page !)
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.js-admin-toggle');
                if (!btn) return;
                e.preventDefault();

                // 1. Verrouillage anti-double-clic !
                if (btn.hasAttribute('disabled')) return;
                btn.setAttribute('disabled', 'true');

                const url = btn.dataset.url;
                const date = btn.dataset.date;
                const heure = btn.dataset.heure;
                const isAdministered = btn.dataset.administered === '1';
                const lateRequired = btn.dataset.lateRequired === '1';

                async function submitAdministration(observation = '') {
                    const formData = new FormData();
                    formData.append('date', date);
                    formData.append('heure', heure);
                    if (observation) formData.append('observation', observation);

                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await response.json();

                        if (data.success) {
                            const td = btn.closest('.hour-cell');
                            if (data.checked) {
                                // Le soin vient d'être administré (Coché)
                                btn.dataset.administered = '1';
                                td.classList.add('hour-active');
                                td.classList.remove('hour-missed', 'hour-upcoming');
                                
                                if (data.late) {
                                    td.classList.add('hour-late');
                                    btn.innerHTML = '<i class="fa fa-clock text-white"></i>';
                                } else {
                                    btn.innerHTML = '<i class="fa fa-check text-white"></i>';
                                }
                            } else {
                                // Le soin vient d'être annulé (Décoché)
                                btn.dataset.administered = '0';
                                td.classList.remove('hour-active', 'hour-late');
                                
                                // 2. Amélioration : Si on décoche un soin en retard, on le remet en rouge (missed)
                                if (lateRequired) {
                                    td.classList.add('hour-missed');
                                    btn.innerHTML = '<i class="fa fa-exclamation text-danger"></i>';
                                } else {
                                    btn.innerHTML = '<span class="admin-dot"></span>';
                                }
                            }
                        } else {
                            alert(data.message || 'Erreur lors de la mise à jour.');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Erreur serveur.');
                    } finally {
                        // 3. Déverrouillage du bouton une fois la requête terminée
                        btn.removeAttribute('disabled');
                    }
                }

                if (!isAdministered && lateRequired) {
                    const lateModalElement = document.getElementById('lateReasonModal');
                    const lateForm = document.getElementById('lateReasonForm');
                    const lateObservation = document.getElementById('lateReasonObservation');
                    
                    if (!lateModalElement || !lateForm || !lateObservation) {
                        alert('Formulaire de justification introuvable.');
                        btn.removeAttribute('disabled');
                        return;
                    }

                    const lateModal = bootstrap.Modal.getOrCreateInstance(lateModalElement);
                    lateObservation.value = '';
                    lateModal.show();

                    const submitHandler = async function (event) {
                        event.preventDefault();
                        const observation = lateObservation.value.trim();
                        if (!observation) {
                            lateObservation.focus();
                            return;
                        }
                        lateModal.hide();
                        lateForm.removeEventListener('submit', submitHandler);
                        await submitAdministration(observation);
                    };

                    // Gestion de l'annulation (fermeture de la modale sans valider)
                    const hideHandler = function () {
                        lateForm.removeEventListener('submit', submitHandler);
                        lateModalElement.removeEventListener('hidden.bs.modal', hideHandler);
                        // On réactive le bouton si l'utilisateur a annulé
                        if (btn.hasAttribute('disabled')) {
                            btn.removeAttribute('disabled');
                        }
                    };

                    lateForm.addEventListener('submit', submitHandler);
                    lateModalElement.addEventListener('hidden.bs.modal', hideHandler);
                    
                    return;
                }

                await submitAdministration();
            });
        });
    </script>
{% endblock %}