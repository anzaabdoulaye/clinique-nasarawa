{# laboratoire/rapport_agents.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Rapport Laboratoire{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Rapport des analyses par agent</h3>
            <p class="text-muted mb-0">
                {% if is_granted('ROLE_ADMIN') %}
                    Vue globale des examens validés par agent.
                {% else %}
                    Vue de vos examens réalisés.
                {% endif %}
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_laboratoire_rapport_agents_pdf', app.request.query.all) }}" target="_blank" class="btn btn-outline-dark">
                Export PDF
            </a>
            <a href="{{ path('app_laboratoire_index') }}" class="btn btn-outline-secondary">Retour au laboratoire</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Analyses validées filtrées</div>
                    <div class="fs-3 fw-bold">{{ nbAnalyses }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Agents (Laborantins) actifs</div>
                    <div class="fs-3 fw-bold">{{ nbAgentsActifs }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Filtres de recherche</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label for="search" class="form-label">Recherche patient / dossier</label>
                    <input type="text" id="search" name="search" value="{{ search }}" class="form-control" placeholder="Code, téléphone, dossier, nom">
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="agent" class="form-label">Compte agent</label>
                    <select id="agent" name="agent" class="form-select" {{ agentFilterLocked ? 'disabled' : '' }}>
                        <option value="">Tous les agents</option>
                        {% for agent in agents %}
                            <option value="{{ agent.id }}" {{ selectedAgentId == agent.id ? 'selected' : '' }}>
                                {{ agent.nomComplet }}{% if agent.username %} | {{ agent.username }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    {% if agentFilterLocked %}
                        <input type="hidden" name="agent" value="{{ selectedAgentId }}">
                        <div class="form-text">Votre compte est appliqué automatiquement.</div>
                    {% endif %}
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label for="dateDebut" class="form-label">Du</label>
                    <input type="date" id="dateDebut" name="dateDebut" value="{{ dateDebut }}" class="form-control">
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label for="dateFin" class="form-label">Au</label>
                    <input type="date" id="dateFin" name="dateFin" value="{{ dateFin }}" class="form-control">
                </div>
                <div class="col-12 col-md-6 col-lg-1 d-grid">
                    <button type="submit" class="btn btn-primary">Filtrer</button>
                </div>
                <div class="col-12">
                    <a href="{{ path('app_laboratoire_rapport_agents') }}" class="btn btn-outline-secondary btn-sm">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Rapport des analyses par agent</h5>
            <span class="text-muted small">Basé sur les résultats validés</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Agent (Compte Laborantin)</th>
                            <th class="text-end">Nombre d'analyses validées</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for ligne in rapportAgents %}
                        <tr>
                            <td class="fw-medium">{{ ligne.libelle }}</td>
                            <td class="text-end fw-semibold fs-5">{{ ligne.nombreAnalyses }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-muted">Aucune analyse trouvée pour ces filtres.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Journal détaillé des examens</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0 datatable" data-export-title="Journal_Examens_Laboratoire">
                    <thead class="table-light">
                        <tr>
                            <th>Date validation</th>
                            <th>Examen</th>
                            <th>Patient</th>
                            <th>Agent ayant validé</th>
                            <th class="text-end no-sort no-export">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for res in resultats %}
                        {% set consultation = res.prescriptionPrestation.consultation|default(null) %}
                        {% set patient = null %}
                        {% if consultation %}
                            {% if consultation.rendezVous and consultation.rendezVous.patient %}
                                {% set patient = consultation.rendezVous.patient %}
                            {% elseif consultation.dossierMedical and consultation.dossierMedical.patient %}
                                {% set patient = consultation.dossierMedical.patient %}
                            {% endif %}
                        {% endif %}
                        <tr>
                            <td>{{ res.dateValidation|date('Y-m-d H:i') }}</td>
                            <td>
                                <strong>{{ res.prescriptionPrestation.tarifPrestation.libelle|default('Examen') }}</strong>
                            </td>
                            <td>
                                {% if patient %}
                                    {{ patient.nomComplet|default((patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim) }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">{{ res.validePar|default('Non renseigné') }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_laboratoire_show', {id: res.prescriptionPrestation.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">Aucun examen validé trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}