{# templates/laboratoire/resultats_consultation_show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Résultats consultation #{{ consultation.id }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% set rdv = consultation.rendezVous|default(null) %}

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <h3 class="mb-1">Fiche consolidée des résultats</h3>
            <div class="text-muted small">
                Consultation #{{ consultation.id }} · {{ prestations|length }} examen{{ prestations|length > 1 ? 's' : '' }} avec résultat
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_laboratoire_index') }}" class="btn btn-outline-secondary">Retour</a>
            <a href="{{ path('app_laboratoire_bon_show', {id: consultation.id}) }}" class="btn btn-outline-secondary">Bon d'examen</a>
            <a href="{{ path('app_laboratoire_resultats_consultation_pdf', {id: consultation.id}) }}" target="_blank" class="btn btn-primary">
                <i class="ri-printer-line me-1"></i> Imprimer la fiche
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Patient</div>
                <div class="card-body">
                    <div class="fs-5 fw-bold text-primary mb-2">
                        {{ patient ? patient.nomComplet|default((patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim) : '-' }}
                    </div>
                    <div class="mb-1"><i class="ri-folder-user-line me-2 text-muted"></i><strong>Dossier :</strong> {{ consultation.dossierMedical ? consultation.dossierMedical.numeroDossier : '-' }}</div>
                    <div class="mb-1"><i class="ri-calendar-event-line me-2 text-muted"></i><strong>Âge :</strong> {{ patient and patient.dateNaissance ? patient.dateNaissance.diff(date()).y ~ ' ans' : '-' }}</div>
                    <div><i class="ri-men-line me-2 text-muted"></i><strong>Sexe :</strong> {{ patient and patient.sexe ? patient.sexe : '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Prescription</div>
                <div class="card-body">
                    <div class="mb-2"><strong>Médecin :</strong> Dr. {{ consultation.medecin.nomComplet|default('-') }}</div>
                    <div class="mb-2"><strong>Consultation :</strong> #{{ consultation.id }}</div>
                    <div class="mb-2"><strong>Date :</strong> {{ consultation.createdAt ? consultation.createdAt|date('d/m/Y H:i') : '-' }}</div>
                    <div><strong>Service :</strong> Laboratoire</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Validation & État</div>
                <div class="card-body">
                    <div class="mb-2">
                        <span class="badge bg-success-subtle text-success fs-6"><i class="ri-check-double-line me-1"></i>Fiche prête à l'impression</span>
                    </div>
                    <div class="mb-1"><strong>Dernière validation :</strong> {{ dateValidationReference ? dateValidationReference|date('d/m/Y H:i') : '-' }}</div>
                    <div class="mt-3"><strong>Biologiste / Technicien :</strong></div>
                    <div class="text-muted fw-medium">
                        {% if validateurs is not empty %}
                            {{ validateurs|join(' · ') }}
                        {% else %}
                            Non renseigné
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Détail des résultats d'analyses</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%;" class="ps-4">Paramètre / Demande</th>
                            <th style="width: 30%;">Résultat</th>
                            <th style="width: 30%;">Valeurs de référence</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for prestation in prestations %}
                            {% set resultat = prestation.resultatLaboratoire %}
                            {% if resultat %}
                                
                                <tr class="table-primary">
                                    <td colspan="3" class="ps-4 py-3 border-top border-bottom border-primary-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="ri-test-tube-line me-2 fs-5 align-middle text-primary"></i>
                                                <span class="fw-bold fs-5 text-primary text-uppercase align-middle">{{ prestation.tarifPrestation.libelle }}</span>
                                                <span class="badge bg-white text-primary border border-primary-subtle ms-3">Qté {{ prestation.quantite }}</span>
                                            </div>
                                            <a href="{{ path('app_laboratoire_show', {id: prestation.id}) }}" class="btn btn-sm btn-light rounded-pill border">
                                                Modifier l'examen
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                {% if resultat.lignes|length > 0 %}
                                    {% set currentGroupe = null %}
                                    {% for ligne in resultat.lignes|sort((a, b) => a.ordre <=> b.ordre) %}
                                        {% if ligne.resultat is not empty and ligne.resultat|trim != '-' %}
                                            
                                            {# Filtre intelligent des groupes génériques #}
                                            {% set displayGroupe = ligne.groupe %}
                                            {% if displayGroupe and displayGroupe|lower not in ['analyses générales', 'analyses generales', 'examen', 'général', ''] and currentGroupe != displayGroupe %}
                                                <tr class="table-light border-bottom border-top border-secondary-subtle">
                                                    <td colspan="3" class="ps-4 py-2 text-muted fw-bold text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                                        {{ displayGroupe }}
                                                    </td>
                                                </tr>
                                                {% set currentGroupe = displayGroupe %}
                                            {% endif %}

                                            <tr>
                                                <td class="ps-5 text-dark">{{ ligne.demande|nl2br }}</td>
                                                <td><span class="fw-bold fs-6">{{ ligne.resultat|nl2br }}</span></td>
                                                <td class="text-muted">{{ ligne.valeurNormale|nl2br }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td class="ps-5">{{ prestation.tarifPrestation.libelle }}</td>
                                        <td><span class="fw-bold">{{ resultat.resultat|nl2br ?: '-' }}</span></td>
                                        <td class="text-muted">-</td>
                                    </tr>
                                {% endif %}

                                {% if resultat.antibiogrammes is defined and resultat.antibiogrammes|length > 0 %}
                                    <tr>
                                        <td colspan="3" class="p-0 border-0">
                                            {% for antibiogramme in resultat.antibiogrammes %}
                                                <div class="bg-danger-subtle px-4 py-3 border-bottom border-danger-subtle">
                                                    <h6 class="text-danger fw-bold mb-2 text-uppercase">
                                                        <i class="ri-virus-line me-1"></i> Antibiogramme - Germe : {{ antibiogramme.germe.nom }}
                                                    </h6>
                                                    
                                                    {% if antibiogramme.numeration or antibiogramme.commentaire %}
                                                        <div class="mb-3 small text-dark">
                                                            {% if antibiogramme.numeration %}<span class="me-4"><strong>Numération :</strong> {{ antibiogramme.numeration }}</span>{% endif %}
                                                            {% if antibiogramme.commentaire %}<span><strong>Observation :</strong> {{ antibiogramme.commentaire }}</span>{% endif %}
                                                        </div>
                                                    {% endif %}

                                                    <div class="row g-2">
                                                    {% for ligneATB in antibiogramme.lignes %}
                                                        {% if ligneATB.sensibilite is not empty %}
                                                            <div class="col-12 col-md-4">
                                                                <div class="bg-white p-2 rounded border border-white d-flex justify-content-between align-items-center shadow-sm">
                                                                    <span class="small fw-medium">{{ ligneATB.antibiotique.nom }}</span>
                                                                    <span class="badge rounded-pill {% if ligneATB.sensibilite == 'S' %}bg-success{% elseif ligneATB.sensibilite == 'R' %}bg-danger{% else %}bg-warning text-dark{% endif %}">
                                                                        {{ ligneATB.sensibilite }}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </td>
                                    </tr>
                                {% endif %}

                                {% if resultat.conclusion %}
                                    <tr class="bg-success-subtle">
                                        <td colspan="3" class="ps-4 py-3 border-bottom border-success-subtle">
                                            <strong class="text-success"><i class="ri-chat-1-line me-1"></i> Conclusion / Observation :</strong> 
                                            <span class="text-dark ms-2">{{ resultat.conclusion|nl2br }}</span>
                                        </td>
                                    </tr>
                                {% endif %}

                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}