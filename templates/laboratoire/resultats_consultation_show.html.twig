{% extends 'base.html.twig' %}

{% block title %}Résultats consultation #{{ consultation.id }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% set rdv = consultation.rendezVous|default(null) %}

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <h3 class="mb-1">Fiche consolidée des résultats</h3>
            <div class="text-muted small">
                Consultation #{{ consultation.id }} · {{ prestations|length }} examen{{ prestations|length > 1 ? 's' : '' }} avec résultat
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a href="{{ path('app_laboratoire_index') }}" class="btn btn-outline-secondary">
                Retour
            </a>
            <a href="{{ path('app_laboratoire_bon_show', {id: consultation.id}) }}" class="btn btn-outline-secondary">
                 Bon d'examen
            </a>
            
            <a href="{{ path('app_laboratoire_resultats_consultation_pdf', {id: consultation.id}) }}"
               target="_blank"
               class="btn btn-primary">
                <i class="ri-printer-line me-1"></i> Imprimer la fiche
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Patient</div>
                <div class="card-body">
                    <div><strong>Nom :</strong>
                        {% if patient %}
                            {{ patient.nomComplet|default((patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim) }}
                        {% else %}
                            -
                        {% endif %}
                    </div>
                    <div><strong>Dossier :</strong> {{ consultation.dossierMedical ? consultation.dossierMedical.numeroDossier : '-' }}</div>
                    <div><strong>Consultation :</strong> #{{ consultation.id }}</div>
                    <div><strong>Rendez-vous :</strong> {{ rdv ? ('#' ~ rdv.id) : '-' }}</div>
                    <div><strong>Âge :</strong> {{ patient and patient.dateNaissance ? patient.dateNaissance.diff(date()).y ~ ' ans' : '-' }}</div>
                    <div><strong>Sexe :</strong> {{ patient and patient.sexe ? patient.sexe : '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Prescription</div>
                <div class="card-body">
                    <div><strong>Médecin :</strong>
                        {{ consultation.medecin.nomComplet|default((consultation.medecin.nom|default('') ~ ' ' ~ consultation.medecin.prenom|default(''))|trim) }}
                    </div>
                    <div><strong>Date consultation :</strong> {{ consultation.createdAt ? consultation.createdAt|date('d/m/Y H:i') : '-' }}</div>
                    <div><strong>Service :</strong> Laboratoire</div>
                    <div><strong>Dernière validation :</strong> {{ dateValidationReference ? dateValidationReference|date('d/m/Y H:i') : '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Validation</div>
                <div class="card-body">
                    <div><strong>Examens avec résultat :</strong> {{ prestations|length }}</div>
                    <div><strong>État :</strong> Fiche consolidée prête à l'impression</div>
                    <div class="mt-2"><strong>Validé par :</strong></div>
                    <div class="small text-muted">
                        {% if validateurs is not empty %}
                            {{ validateurs|join(' · ') }}
                        {% else %}
                            Non renseigné
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column gap-3">
        {% for prestation in prestations %}
            {% set resultat = prestation.resultatLaboratoire %}

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
                    <div>
                        <div class="fw-semibold">{{ prestation.tarifPrestation.libelle }}</div>
                        <div class="text-muted small">
                            Examen #{{ prestation.id }} · {{ prestation.tarifPrestation.categorie.value|replace({'_':' '})|title }}
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge rounded-pill text-bg-light border">Qté {{ prestation.quantite }}</span>
                        <a href="{{ path('app_laboratoire_show', {id: prestation.id}) }}" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                            Ouvrir l'examen
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    {% if prestation.instructions %}
                        <div class="alert alert-light border mb-3">
                            <strong>Instructions :</strong> {{ prestation.instructions }}
                        </div>
                    {% endif %}

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 28%;">Paramètre / Demande</th>
                                    <th style="width: 36%;">Résultat</th>
                                    <th style="width: 36%;">Valeurs normales</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if resultat and resultat.lignes|length > 0 %}
                                    {% set currentGroupe = null %}
                                    {% for ligne in resultat.lignes|sort((a, b) => a.ordre <=> b.ordre) %}
                                        {% if ligne.resultat is not empty and ligne.resultat|trim != '-' %}
                                            
                                            {# GESTION DE L'AFFICHAGE DU GROUPE #}
                                            {% set displayGroupe = ligne.groupe|default('Analyses Générales') %}
                                            {% if currentGroupe != displayGroupe %}
                                                <tr class="table-secondary">
                                                    <td colspan="3" class="fw-bold text-uppercase text-primary" style="font-size: 0.85rem;">
                                                        {{ displayGroupe }}
                                                    </td>
                                                </tr>
                                                {% set currentGroupe = displayGroupe %}
                                            {% endif %}

                                            <tr>
                                                <td class="ps-4">{{ ligne.demande|nl2br }}</td>
                                                <td>{{ ligne.resultat ? ligne.resultat|nl2br : '-' }}</td>
                                                <td class="text-muted">{{ ligne.valeurNormale ? ligne.valeurNormale|nl2br : '-' }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td>{{ prestation.tarifPrestation.libelle }}</td>
                                        <td>{{ resultat and resultat.resultat ? resultat.resultat|nl2br : '-' }}</td>
                                        <td>-</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>

                    {% if resultat and resultat.antibiogrammes is defined and resultat.antibiogrammes|length > 0 %}
                        <div class="mt-4">
                            <h6 class="text-primary mb-3 border-bottom pb-2">
                                <i class="ri-microscope-line me-1"></i> Bactériologie & Antibiogrammes
                            </h6>
                            
                            <div class="row g-3">
                                {% for antibiogramme in resultat.antibiogrammes %}
                                    <div class="col-12">
                                        <div class="card border-primary-subtle shadow-sm">
                                            <div class="card-header bg-primary-subtle text-primary-emphasis fw-bold py-2 d-flex flex-wrap justify-content-between align-items-center">
                                                <span>Antibiogramme</span>
                                                <span>Germe isolé : <strong class="text-danger fs-6">{{ antibiogramme.germe.nom }}</strong></span>
                                            </div>
                                            
                                            {% if antibiogramme.numeration or antibiogramme.commentaire %}
                                                <div class="card-body bg-light py-2 border-bottom">
                                                    <div class="row small">
                                                        {% if antibiogramme.numeration %}
                                                            <div class="col-md-6"><strong>Numération :</strong> {{ antibiogramme.numeration }}</div>
                                                        {% endif %}
                                                        {% if antibiogramme.commentaire %}
                                                            <div class="col-md-6"><strong>Observation :</strong> {{ antibiogramme.commentaire }}</div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            {% endif %}

                                            <div class="table-responsive">
                                                <table class="table table-sm table-borderless table-striped align-middle mb-0">
                                                    <thead class="table-light border-bottom">
                                                        <tr>
                                                            <th class="ps-3" style="width: 40%;">Antibiotique testé</th>
                                                            <th style="width: 30%;">Famille</th>
                                                            <th style="width: 30%;">Sensibilité</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% set hasSaisi = false %}
                                                        {% for ligneATB in antibiogramme.lignes %}
                                                            {% if ligneATB.sensibilite is not empty %}
                                                                {% set hasSaisi = true %}
                                                                <tr>
                                                                    <td class="ps-3 fw-medium">{{ ligneATB.antibiotique.nom }}</td>
                                                                    <td class="text-muted small">{{ ligneATB.antibiotique.famille|default('-') }}</td>
                                                                    <td>
                                                                        <span class="badge rounded-pill {% if ligneATB.sensibilite == 'S' %}bg-success{% elseif ligneATB.sensibilite == 'R' %}bg-danger{% else %}bg-warning text-dark{% endif %} px-3 py-2">
                                                                            {{ ligneATB.sensibilite }}
                                                                            {% if ligneATB.sensibilite == 'S' %} (Sensible)
                                                                            {% elseif ligneATB.sensibilite == 'R' %} (Résistant)
                                                                            {% elseif ligneATB.sensibilite == 'I' %} (Intermédiaire)
                                                                            {% endif %}
                                                                        </span>
                                                                    </td>
                                                                </tr>
                                                            {% endif %}
                                                        {% endfor %}
                                                        
                                                        {% if not hasSaisi %}
                                                            <tr>
                                                                <td colspan="3" class="text-center text-muted fst-italic py-3">
                                                                    Aucune sensibilité n'a été saisie pour ce germe.
                                                                </td>
                                                            </tr>
                                                        {% endif %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    {% if resultat and resultat.conclusion %}
                        <div class="mt-4">
                            <div class="fw-semibold mb-2 text-dark">Conclusion / Observation</div>
                            <div class="border rounded-3 p-3 bg-light-subtle text-dark">{{ resultat.conclusion|nl2br }}</div>
                        </div>
                    {% endif %}

                    <div class="mt-3 pt-3 border-top small text-muted d-flex flex-wrap gap-3">
                        <span><strong>Validation :</strong> <i class="ri-calendar-line ms-1"></i> {{ resultat and resultat.dateValidation ? resultat.dateValidation|date('d/m/Y H:i') : '-' }}</span>
                        <span><strong>Laborantin :</strong> <i class="ri-user-line ms-1"></i> {{ resultat and resultat.validePar ? resultat.validePar : '-' }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}