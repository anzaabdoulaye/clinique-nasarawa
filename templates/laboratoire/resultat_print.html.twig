<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Résultat Laboratoire - {{ prestation.tarifPrestation.libelle }}</title>
    <style>
        @page { size: A4 portrait; margin: 8mm; }
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 10px; color: #1f2937; margin: 0; padding: 0; }
        .document { width: 100%; border: 1px solid #cfd8e3; border-radius: 8px; padding: 12px; }
        .top-bar { height: 4px; background: #0f4c81; margin-bottom: 10px; border-radius: 4px; }
        table { width: 100%; border-collapse: collapse; }
        td, th { vertical-align: top; }
        
        .header-table { border-bottom: 2px solid #0f4c81; padding-bottom: 8px; margin-bottom: 12px; }
        .clinic-title { font-size: 14px; font-weight: bold; color: #0f4c81; margin: 0; }
        .clinic-meta { font-size: 8px; color: #4b5563; line-height: 1.3; }
        .qr-box { border: 1px solid #cfd8e3; border-radius: 6px; padding: 4px; text-align: center; background: #f9fafb; }
        
        .section-title { background: #0f4c81; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px; margin-top: 12px; margin-bottom: 6px; border-radius: 4px; }
        .info-table td { padding: 3px 0; }
        
        .data-table { width: 100%; margin-top: 8px; }
        .data-table th { background: #0f4c81; color: white; border: 1px solid #0f4c81; padding: 6px; text-align: left; font-weight: bold; }
        .data-table td { border: 1px solid #e5e7eb; padding: 6px; }
        
        .conclusion-box { margin-top: 12px; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; background: #f9fafb; }
        .footer-note { text-align: center; margin-top: 30px; font-size: 8px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 8px; }
        .signatures { margin-top: 20px; width: 100%; }
        .signature-block { width: 50%; padding: 5px; font-size: 9px; text-align: center; }
    </style>
</head>
<body>
    <div class="document">
        <div class="top-bar"></div>
        
        <table class="header-table">
            <tr>
            <td style="width:15%;">
                        <img src="{{ absolute_url(asset('assets/images/logo.jpeg')) }}" alt="Logo Clinique" class="clinic-logo">
                    </td>
                <td style="width: 75%;">
                    <div class="clinic-title">CLINIQUE NEUROLOGIQUE NASSARAWA</div>
                    <div class="clinic-meta">
                        NIF : 120402/R · RCCM : NE-NIM-01-2024-B12-00145<br>
                        Yantala Haut Avenue du Daoura YN 187<br>
                        Tél : 20 75 51 02 / 82 09 61 12 · BP : 2120 Niamey<br>
                        Email : nassarawaclinique@gmail.com
                    </div>
                </td>
                <td style="width: 25%; text-align: right;">
                    {% if qrCodeBase64 is defined and qrCodeBase64 %}
                        <div class="qr-box">
                            <img src="{{ qrCodeBase64 }}" alt="QR Verification" style="width: 55px; height: 55px;"><br>
                            <span style="font-size: 7px; color: #6b7280;">Code : LAB-{{ resultat.id }}</span>
                        </div>
                    {% endif %}
                </td>
            </tr>
        </table>

        <div style="text-align: center; font-size: 12px; font-weight: bold; color: #0f4c81; margin: 8px 0; text-transform: uppercase;">
            RÉSULTAT DE LABORATOIRE : {{ prestation.tarifPrestation.libelle }}
        </div>

        <div class="section-title">INFORMATIONS DU PATIENT ET DE L'EXAMEN</div>
        <table class="info-table">
            <tr>
                <td style="width: 50%;"><strong>Nom et prénom :</strong> {{ patient.nomComplet|default(patient.nom ~ ' ' ~ patient.prenom) }}</td>
                <td style="width: 50%;"><strong>Référence :</strong> LAB-{{ resultat.id }}</td>
            </tr>
            <tr>
                <td><strong>Âge / Sexe :</strong> {{ patient.age|default('-') }} ans / {{ patient.sexe|default('-') }}</td>
                <td><strong>Date de validation :</strong> {{ resultat.dateValidation ? resultat.dateValidation|date('d/m/Y H:i') : '-' }}</td>
            </tr>
            <tr>
                <td colspan="2"><strong>Consultation :</strong> #{{ consultation.id }}</td>
            </tr>
        </table>

        <div class="section-title">RÉSULTATS DU LABORATOIRE</div>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 45%;">Paramètre / Demande</th>
                    <th style="width: 25%;">Résultat</th>
                    <th style="width: 30%;">Valeurs normales</th>
                </tr>
            </thead>
            <tbody>
                {% if resultat.lignes|length > 0 %}
                    {% for ligne in resultat.lignes|sort((a, b) => a.ordre <=> b.ordre) %}
                        {# EXCLUSION CHIRURGICALE DES LIGNES VIDES #}
                        {% if ligne.resultat is not empty and ligne.resultat|trim != '-' and ligne.resultat|trim != '' %}
                            <tr>
                                <td>{{ ligne.demande }}</td>
                                <td><strong>{{ ligne.resultat }}</strong></td>
                                <td style="color: #4b5563;">{{ ligne.valeurNormale ?: '-' }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>{{ prestation.tarifPrestation.libelle }}</td>
                        <td><strong>{{ resultat.resultat ?: '-' }}</strong></td>
                        <td>-</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        {% if resultat.conclusion %}
            <div class="conclusion-box">
                <div style="font-weight: bold; color: #0f4c81; font-size: 9px; margin-bottom: 4px;">CONCLUSION / OBSERVATION GÉNÉRALE :</div>
                <div>{{ resultat.conclusion|nl2br }}</div>
            </div>
        {% endif %}

        <div class="section-title">TRAÇABILITÉ ET VALIDATION</div>
        <table style="width: 100%; margin-top: 5px; font-size: 8px; color: #4b5563;">
            <tr>
                <td><strong>Laborantin :</strong> {{ resultat.validePar|default('Non renseigné') }}</td>
                <td style="text-align: right;">Document généré par le système informatique de la clinique</td>
            </tr>
        </table>

        <table class="signatures">
            <tr>
                <td class="signature-block">
                    <div style="border-bottom: 1px dashed #cfd8e3; width: 70%; margin: 0 auto 40px auto; padding-bottom: 5px;">Signature du Technicien / Biologiste</div>
                </td>
                <td class="signature-block">
                    <div style="border-bottom: 1px dashed #cfd8e3; width: 70%; margin: 0 auto 40px auto; padding-bottom: 5px;">Cachet du Laboratoire</div>
                </td>
            </tr>
        </table>

        <div class="footer-note">
            Clinique Médicale Nassarawa — Résultat confidentiel à remettre au médecin traitant.
        </div>
    </div>
</body>
</html>