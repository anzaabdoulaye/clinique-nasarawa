{# templates/laboratoire/_table.html.twig #}
<div class="table-responsive">
    <table class="table table-borderless align-middle table-hover mb-0 datatable labo-table">
        <thead>
            <tr>
                <th class="text-muted small fw-semibold">Consultation</th>
                <th class="text-muted small fw-semibold">Patient</th>
                <th class="text-muted small fw-semibold">Examens</th>
                <th class="text-muted small fw-semibold">Médecin</th>
                <th class="text-muted small fw-semibold">Date prescription</th>
                <th class="text-muted small fw-semibold">Statut</th>
                <th class="text-end text-muted small fw-semibold">Actions</th>
            </tr>
        </thead>

        <tbody>

        {% for item in consultations %}

            {% set consultation = item.consultation %}
            {% set patient = item.patient %}
            {% set medecin = item.medecin %}
            {% set prestations = item.prestations %}
            {% set nombreExamens = item.nombreExamens %}

            {% set firstPrestation = prestations|first %}
            {% set statut = firstPrestation ? firstPrestation.statut.value : '' %}

            {% set patientNom = patient
                ? patient.nomComplet|default((patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim)
                : 'Patient non renseigné'
            %}

            {% set medecinNom = medecin
                ? medecin.nomComplet|default((medecin.nom|default('') ~ ' ' ~ medecin.prenom|default(''))|trim)
                : 'Non assigné'
            %}

            <tr>

                {# Consultation #}
                <td>
                    <div class="fw-semibold text-dark">
                        #{{ consultation.id }}
                    </div>

                    <div class="text-muted small">
                        {{ nombreExamens }} examen(s)
                    </div>
                </td>

                {# Patient #}
                <td>
                    <div class="d-flex align-items-center gap-3">
                        <div class="patient-avatar">
                            <i class="ri-user-3-line"></i>
                        </div>

                        <div>
                            <div class="fw-semibold text-dark">
                                {{ patientNom ?: '-' }}
                            </div>

                            <div class="text-muted small">

                                {% if patient and patient.code is defined and patient.code %}
                                    Code : {{ patient.code }}

                                {% elseif consultation.rendezVous %}
                                    Rendez-vous #{{ consultation.rendezVous.id }}

                                {% elseif consultation.dossierMedical %}
                                    Dossier {{ consultation.dossierMedical.numeroDossier|default('#' ~ consultation.dossierMedical.id) }}

                                {% else %}
                                    Patient non lié
                                {% endif %}

                            </div>
                        </div>
                    </div>
                </td>

                {# Examens regroupés #}
                <td style="min-width: 320px;">

                    <div class="d-flex flex-wrap gap-2">

                        {% for prestation in prestations %}

                            <span class="badge rounded-pill bg-info-subtle text-info border px-3 py-2">

                                {{ prestation.tarifPrestation.libelle }}

                            </span>

                        {% endfor %}

                    </div>

                </td>

                {# Médecin #}
                <td>
                    <div class="fw-semibold text-dark">
                        {{ medecinNom }}
                    </div>
                </td>

                {# Date #}
                <td>

                    {% if firstPrestation and firstPrestation.createdAt %}

                        <div class="fw-semibold text-dark">
                            {{ firstPrestation.createdAt|date('d/m/Y') }}
                        </div>

                        <div class="text-muted small">
                            {{ firstPrestation.createdAt|date('H:i') }}
                        </div>

                    {% else %}
                        -
                    {% endif %}

                </td>

                {# Statut #}
                <td>

                    {% if statut == 'paye' %}

                        <span class="badge rounded-pill text-bg-warning px-3 py-2">
                            <i class="ri-time-line me-1"></i>
                            À traiter
                        </span>

                    {% elseif statut == 'en_cours' %}

                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                            <i class="ri-loader-4-line me-1"></i>
                            En cours
                        </span>

                    {% elseif statut == 'realise' %}

                        <span class="badge rounded-pill text-bg-success px-3 py-2">
                            <i class="ri-checkbox-circle-line me-1"></i>
                            Réalisé
                        </span>

                    {% else %}

                        <span class="badge rounded-pill text-bg-dark px-3 py-2">
                            {{ statut|replace({'_':' '})|title }}
                        </span>

                    {% endif %}

                </td>

                {# Actions #}
                <td class="text-end">

                    <div class="d-flex justify-content-end flex-wrap gap-2">

                        <a href="{{ path('app_laboratoire_consultation_show', {
                            id: consultation.id
                        }) }}"
                        class="btn btn-sm btn-primary rounded-pill px-3">

                            <i class="ri-eye-line me-1"></i>
                            Ouvrir

                        </a>

                        <a href="{{ path('app_laboratoire_resultats_consultation_pdf', {
                            id: consultation.id
                        }) }}"
                           class="btn btn-sm btn-outline-dark rounded-pill px-3">

                            <i class="ri-printer-line me-1"></i>
                            Imprimer

                        </a>

                    </div>

                </td>

            </tr>

        {% else %}

            <tr>
                <td colspan="7" class="text-center py-5">

                    <div class="d-flex flex-column align-items-center">

                        <i class="ri-flask-line fs-1 text-muted mb-3"></i>

                        <div class="fw-semibold text-muted">
                            {{ emptyMessage }}
                        </div>

                    </div>

                </td>
            </tr>

        {% endfor %}

        </tbody>
    </table>
</div>

<style>
    .labo-table {
        --bs-table-bg: transparent;
    }

    .labo-table thead th {
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        padding-top: 1rem;
        padding-bottom: 1rem;
        white-space: nowrap;
    }

    .labo-table tbody tr {
        background: #fff;
        transition: all .2s ease;
        border-bottom: 1px solid #f1f5f9;
    }

    .labo-table tbody tr:hover {
        background: #f8fbff;
    }

    .labo-table tbody td {
        padding-top: 1rem;
        padding-bottom: 1rem;
        vertical-align: middle;
    }

    .patient-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .empty-state {
        padding: 1rem;
    }

    .empty-state-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto;
        border-radius: 50%;
        background: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .badge.text-bg-warning {
        color: #664d03 !important;
        background-color: #fff3cd !important;
    }

    .badge.text-bg-primary {
        background-color: #0d6efd !important;
    }

    .badge.text-bg-success {
        background-color: #198754 !important;
    }
</style>