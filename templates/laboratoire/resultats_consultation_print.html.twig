{# templates/laboratoire/resultats_consultation_print.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    {% set patient = patient|default(consultation.dossierMedical.patient|default(consultation.rendezVous.patient|default(null))) %}
    <meta charset="UTF-8">
    <title>Fiche Consolidée des Résultats - Consultation #{{ consultation.id }}</title>
    <style>
        @page { size: A4 portrait; margin: 10mm; }
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 10px; color: #1f2937; margin: 0; padding: 0; }
        .document { width: 100%; border: 1px solid #cfd8e3; border-radius: 8px; padding: 12px; }
        .top-bar { height: 4px; background: #0f4c81; margin-bottom: 10px; border-radius: 4px; }
        table { width: 100%; border-collapse: collapse; }
        td, th { vertical-align: top; }
        
        .header-table { border-bottom: 2px solid #0f4c81; padding-bottom: 8px; margin-bottom: 12px; }
        .clinic-title { font-size: 14px; font-weight: bold; color: #0f4c81; margin: 0; }
        .clinic-meta { font-size: 8px; color: #4b5563; line-height: 1.3; }
        .qr-box { border: 1px solid #cfd8e3; border-radius: 6px; padding: 4px; text-align: center; background: #f9fafb; }
        
        .section-title { background: #0f4c81; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px; margin-top: 12px; margin-bottom: 6px; border-radius: 4px; text-transform: uppercase; }
        .info-table td { padding: 3px 0; }
        
        /* Styles pour le tableau unique */
        table.master-table { page-break-inside: auto; margin-top: 10px; border: 1px solid #d1d5db; }
        table.master-table thead { display: table-header-group; }
        table.master-table tr { page-break-inside: avoid; page-break-after: auto; }
        
        table.master-table th { background: #f3f4f6; color: #1f2937; border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; font-weight: bold; font-size: 9px; text-transform: uppercase; }
        table.master-table td { border: 1px solid #e5e7eb; padding: 5px 8px; font-size: 9.5px; vertical-align: middle; }
        
        /* Séparateur d'examen */
        .row-examen td { background-color: #e5e7eb; color: #0f4c81; font-weight: bold; font-size: 11px; text-transform: uppercase; padding: 6px 8px; border-top: 2px solid #9ca3af; }
        
        /* Séparateur de groupe (Macroscopie, etc.) */
        .row-groupe td { background-color: #f8fafc; color: #4b5563; font-style: italic; font-weight: bold; font-size: 9px; padding: 4px 8px; border-top: 1px dashed #d1d5db; }
        
        /* Conclusion */
        .row-conclusion td { background-color: #f0fdf4; border-left: 3px solid #22c55e !important; color: #166534; font-size: 9.5px; padding: 6px 8px; }
        
        .footer-note { text-align: center; margin-top: 30px; font-size: 8px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 8px; }
    </style>
</head>
<body>
    <div class="document">
        <div class="top-bar"></div>
        
        <table class="header-table">
            <tr>
                <td style="width: 15%; vertical-align: middle;">
                    <img src="{{ absolute_url(asset('assets/images/logo.jpeg')) }}" alt="Logo Clinique" style="width: 100px; height: auto;">
                </td>
                <td style="width: 60%; vertical-align: middle;">
                    <div class="clinic-title">Clinique Neurologique Nassarawa</div>
                    <div class="clinic-meta">
                        <strong>NIF :</strong> 120402/R | <strong>RCCM :</strong> NE-NIM-01-2024-B12-00145<br>
                        <strong>Adresse :</strong> Yantala Haut, Avenue du Daoura YN 187, Niamey<br>
                        <strong>Tél :</strong> 20 75 51 02 / 82 09 61 12<br>
                        <strong>Email :</strong> nassrawaclinique@gmail.com
                    </div>
                </td>
                <td style="width: 25%; text-align: right; vertical-align: middle;">
                    <div class="qr-box">
                        {% if qrCodeBase64 is defined and qrCodeBase64 %}
                            <img src="{{ qrCodeBase64 }}" alt="QR Verification" style="width: 55px; height: 55px; margin-bottom: 2px;"><br>
                        {% endif %}
                        <span style="font-size: 8px; font-weight: bold; color: #0f4c81;">DOSSIER GLOBAL</span><br>
                        <span style="font-size: 7px; color: #6b7280;">Consultation #{{ consultation.id }}</span>
                    </div>
                </td>
            </tr>
        </table>

        <div class="section-title">COMPTE-RENDU CONSOLIDÉ DE LABORATOIRE</div>
        <table class="info-table">
            <tr>
                <td style="width: 50%;"><strong>Patient :</strong> {{ patient.nomComplet|default(patient.nom ~ ' ' ~ patient.prenom)|upper }}</td>
                <td style="width: 50%;"><strong>Consultation :</strong> #{{ consultation.id }}</td>
            </tr>
            <tr>
                <td><strong>Âge / Sexe :</strong> {{ patient.age|default('-') }} ans / {{ patient.sexe|default('-') }}</td>
                <td><strong>Date Impression :</strong> {{ "now"|date("d/m/Y H:i") }}</td>
            </tr>
            <tr>
                <td colspan="2"><strong>Médecin prescripteur :</strong> Dr. {{ consultation.medecin.nomComplet|default('-') }}</td>
            </tr>
        </table>

        <table class="master-table">
            <thead>
                <tr>
                    <th style="width: 45%;">Paramètre biologique</th>
                    <th style="width: 25%;">Résultat observé</th>
                    <th style="width: 30%;">Valeurs de référence</th>
                </tr>
            </thead>
            <tbody>
                {% for prescription in prestations %}
                    {% set resultat = prescription.resultatLaboratoire %}
                    
                    {% if resultat %}
                        <tr class="row-examen">
                            <td colspan="3">
                                {{ prescription.tarifPrestation.libelle }}
                                <span style="float: right; font-size: 8px; font-weight: normal; color: #4b5563;">
                                    Validé le : {{ resultat.dateValidation ? resultat.dateValidation|date('d/m/Y H:i') : '-' }}
                                </span>
                            </td>
                        </tr>

                        {% if resultat.lignes|length > 0 %}
                            {% set currentGroupe = null %}
                            {% for ligne in resultat.lignes|sort((a, b) => a.ordre <=> b.ordre) %}
                                {% if ligne.resultat is not empty and ligne.resultat|trim != '-' and ligne.resultat|trim != '' %}
                                    
                                    {# Gestion Intelligente des Groupes #}
                                    {% set displayGroupe = ligne.groupe %}
                                    {% if displayGroupe and displayGroupe|lower not in ['analyses générales', 'analyses generales', 'examen', 'général', ''] and currentGroupe != displayGroupe %}
                                        <tr class="row-groupe">
                                            <td colspan="3">{{ displayGroupe|upper }}</td>
                                        </tr>
                                        {% set currentGroupe = displayGroupe %}
                                    {% endif %}

                                    <tr>
                                        <td style="padding-left: 12px;">{{ ligne.demande }}</td>
                                        <td><strong>{{ ligne.resultat }}</strong></td>
                                        <td style="color: #4b5563;">{{ ligne.valeurNormale ?: '-' }}</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td style="padding-left: 12px;">{{ prescription.tarifPrestation.libelle }}</td>
                                <td><strong>{{ resultat.resultat ?: '-' }}</strong></td>
                                <td style="color: #4b5563;">-</td>
                            </tr>
                        {% endif %}

                        {% if resultat.antibiogrammes is defined and resultat.antibiogrammes|length > 0 %}
                            {% for antibiogramme in resultat.antibiogrammes %}
                                <tr>
                                    <td colspan="3" style="padding: 0;">
                                        <div style="background-color: #fef2f2; border-top: 1px solid #fca5a5; padding: 6px 8px;">
                                            <div style="color: #b91c1c; font-weight: bold; font-size: 10px; margin-bottom: 4px;">
                                                ANTIBIOGRAMME - GERME ISOLÉ : {{ antibiogramme.germe.nom|upper }}
                                            </div>
                                            {% if antibiogramme.numeration or antibiogramme.commentaire %}
                                                <div style="font-size: 8.5px; color: #4b5563; margin-bottom: 6px;">
                                                    {% if antibiogramme.numeration %}<strong>Numération :</strong> {{ antibiogramme.numeration }} | {% endif %}
                                                    {% if antibiogramme.commentaire %}<strong>Obs :</strong> {{ antibiogramme.commentaire }}{% endif %}
                                                </div>
                                            {% endif %}
                                            
                                            <table style="width: 100%; font-size: 8.5px; border-collapse: collapse;">
                                                {% for ligneATB in antibiogramme.lignes %}
                                                    {% if ligneATB.sensibilite is not empty %}
                                                        <tr>
                                                            <td style="width: 45%; border-bottom: 1px solid #fecaca; padding: 3px 0;">{{ ligneATB.antibiotique.nom }}</td>
                                                            <td style="width: 25%; border-bottom: 1px solid #fecaca; padding: 3px 0;">{{ ligneATB.antibiotique.famille|default('-') }}</td>
                                                            <td style="width: 30%; border-bottom: 1px solid #fecaca; padding: 3px 0;">
                                                                <strong style="color: {% if ligneATB.sensibilite == 'S' %}#15803d{% elseif ligneATB.sensibilite == 'R' %}#b91c1c{% else %}#b45309{% endif %};">
                                                                    {{ ligneATB.sensibilite }} 
                                                                    {% if ligneATB.sensibilite == 'S' %}(Sensible){% elseif ligneATB.sensibilite == 'R' %}(Résistant){% elseif ligneATB.sensibilite == 'I' %}(Intermédiaire){% endif %}
                                                                </strong>
                                                            </td>
                                                        </tr>
                                                    {% endif %}
                                                {% endfor %}
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
        <table style="width: 100%; margin-top: 35px; font-size: 9px;">
            <tr>
                <td style="width: 50%; text-align: center; vertical-align: top;">
                    <div style="border-top: 1px dashed #cfd8e3; width: 85%; margin: 0 auto; padding-top: 8px;">
                        <strong style="color: #0f4c81;">VALIDATION BIOLOGIQUE :</strong><br>
                        <div style="margin-top: 4px; font-size: 8.5px; color: #1f2937; font-weight: bold;">
                            {% for validateur in validateurs|default([]) %}
                                {{ validateur }}<br>
                            {% else %}
                                Laboratoire Nassarawa
                            {% endfor %}
                        </div>
                    </div>
                </td>
                <td style="width: 50%; text-align: center; vertical-align: top;">
                    <div style="border-top: 1px dashed #cfd8e3; width: 85%; margin: 0 auto; padding-top: 8px;">
                        <strong style="color: #0f4c81;">CACHET DU LABORATOIRE & SIGNATURE</strong>
                    </div>
                </td>
            </tr>
        </table>

        <div class="footer-note">
            Clinique Médicale Nassarawa — Fin du compte-rendu consolidé biologique.
        </div>
    </div>
</body>
</html>