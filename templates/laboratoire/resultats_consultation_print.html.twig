<!DOCTYPE html>
<html lang="fr">
<head>
    {% set patient = patient|default(consultation.dossierMedical.patient|default(consultation.rendezVous.patient|default(null))) %}
    <meta charset="UTF-8">
    <title>Fiche Consolidée des Résultats - Consultation #{{ consultation.id }}</title>
    <style>
        @page { size: A4 portrait; margin: 8mm; }
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 10px; color: #1f2937; margin: 0; padding: 0; }
        .document { width: 100%; border: 1px solid #cfd8e3; border-radius: 8px; padding: 12px; }
        .top-bar { height: 4px; background: #0f4c81; margin-bottom: 10px; border-radius: 4px; }
        table { width: 100%; border-collapse: collapse; }
        td, th { vertical-align: top; }
        
        .header-table { border-bottom: 2px solid #0f4c81; padding-bottom: 8px; margin-bottom: 12px; }
        .clinic-title { font-size: 14px; font-weight: bold; color: #0f4c81; margin: 0; }
        .clinic-meta { font-size: 8px; color: #4b5563; line-height: 1.3; }
        .qr-box { border: 1px solid #cfd8e3; border-radius: 6px; padding: 4px; text-align: center; background: #f9fafb; }
        
        .section-title { background: #0f4c81; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px; margin-top: 12px; margin-bottom: 6px; border-radius: 4px; }
        .info-table td { padding: 3px 0; }
        
        .examen-block { border: 1px solid #e5e7eb; border-radius: 6px; margin-bottom: 14px; padding: 8px; background: #fff; }
        .examen-header { font-weight: bold; color: #0f4c81; border-bottom: 1px solid #e5e7eb; padding-bottom: 4px; margin-bottom: 6px; font-size: 10px; }
        
        .data-table th { background: #f3f4f6; color: #1f2937; border: 1px solid #d1d5db; padding: 4px 6px; text-align: left; font-weight: bold; font-size: 9px; }
        .data-table td { border: 1px solid #e5e7eb; padding: 4px 6px; font-size: 9px; }
        
        .footer-note { text-align: center; margin-top: 30px; font-size: 8px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 8px; }
    </style>
</head>
<body>
    <div class="document">
        <div class="top-bar"></div>
        
        <table class="header-table">
            <tr>
                <td style="width: 15%; vertical-align: middle;">
                    <img src="{{ absolute_url(asset('assets/images/logo.jpeg')) }}" alt="Logo Clinique" style="width: 100px; height: auto;">
                </td>
                <td style="width: 60%; vertical-align: middle;">
                    <div class="clinic-title">Clinique Neurologique Nassarawa</div>
                    <div class="clinic-meta">
                        <strong>NIF :</strong> 120402/R | <strong>RCCM :</strong> NE-NIM-01-2024-B12-00145<br>
                        <strong>Adresse :</strong> Yantala Haut, Avenue du Daoura YN 187, Niamey<br>
                        <strong>Tél :</strong> 20 75 51 02 / 82 09 61 12<br>
                        <strong>Email :</strong> nassrawaclinique@gmail.com
                    </div>
                </td>
                <td style="width: 25%; text-align: right; vertical-align: middle;">
                    <div class="qr-box">
                        {% if qrCodeBase64 is defined and qrCodeBase64 %}
                            <img src="{{ qrCodeBase64 }}" alt="QR Verification" style="width: 55px; height: 55px; margin-bottom: 2px;"><br>
                        {% endif %}
                        <span style="font-size: 8px; font-weight: bold; color: #0f4c81;">DOSSIER GLOBAL</span><br>
                        <span style="font-size: 7px; color: #6b7280;">Consultation #{{ consultation.id }}</span>
                    </div>
                </td>
            </tr>
        </table>

        <div class="section-title">COMPTE-RENDU CONSOLIDÉ DE LABORATOIRE</div>
        <table class="info-table">
            <tr>
                <td style="width: 50%;"><strong>Patient :</strong> {{ patient.nomComplet|default(patient.nom ~ ' ' ~ patient.prenom) }}</td>
                <td style="width: 50%;"><strong>Consultation :</strong> #{{ consultation.id }}</td>
            </tr>
            <tr>
                <td><strong>Âge / Sexe :</strong> {{ patient.age }} ans / {{ patient.sexe|default('-') }}</td>
                <td><strong>Date Impression :</strong> {{ "now"|date("d/m/Y H:i") }}</td>
            </tr>
        </table>

        <div style="margin-top: 10px;">
            {% for prescription in prestations %}
                {% set resultat = prescription.resultatLaboratoire %}
                
                <div class="examen-block">
                    <div class="examen-header">
                        Analyse : {{ prescription.tarifPrestation.libelle }}
                        <span style="float: right; font-size: 8px; color: #6b7280; font-weight: normal;">
                            Validé le : {{ resultat and resultat.dateValidation ? resultat.dateValidation|date('d/m/Y H:i') : '-' }} par {{ resultat and resultat.validePar ? resultat.validePar : '-' }}
                        </span>
                    </div>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;">Paramètre biologique</th>
                                <th style="width: 25%;">Résultat observé</th>
                                <th style="width: 25%;">Valeurs de référence</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if resultat and resultat.lignes|length > 0 %}
                                {% set currentGroupe = null %}
                                {% for ligne in resultat.lignes|sort((a, b) => a.ordre <=> b.ordre) %}
                                    {% if ligne.resultat is not empty and ligne.resultat|trim != '-' and ligne.resultat|trim != '' %}
                                        
                                        {# GESTION DE L'AFFICHAGE DU GROUPE #}
                                        {% set displayGroupe = ligne.groupe|default('Analyses Générales') %}
                                        {% if currentGroupe != displayGroupe %}
                                            <tr>
                                                <td colspan="3" style="background-color: #f3f4f6; color: #0f4c81; font-weight: bold; padding: 4px 6px; text-transform: uppercase; font-size: 9px; border: 1px solid #d1d5db;">
                                                    {{ displayGroupe }}
                                                </td>
                                            </tr>
                                            {% set currentGroupe = displayGroupe %}
                                        {% endif %}

                                        <tr>
                                            <td style="padding-left: 12px;">{{ ligne.demande }}</td>
                                            <td><strong>{{ ligne.resultat }}</strong></td>
                                            <td style="color: #4b5563;">{{ ligne.valeurNormale ?: '-' }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td>{{ prescription.tarifPrestation.libelle }}</td>
                                    <td><strong>{{ (resultat and resultat.resultat) ? resultat.resultat : '-' }}</strong></td>
                                    <td>-</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>

                    {% if resultat and resultat.antibiogrammes is defined and resultat.antibiogrammes|length > 0 %}
                        {% for antibiogramme in resultat.antibiogrammes %}
                            <div style="margin-top: 10px; border: 1px solid #d1d5db;">
                                <div style="background-color: #e5e7eb; padding: 4px 6px; font-weight: bold; font-size: 9.5px; color: #0f4c81;">
                                    <span style="text-transform: uppercase;">Antibiogramme</span> - Germe isolé : <span style="color: #b91c1c;">{{ antibiogramme.germe.nom }}</span>
                                </div>

                                {% if antibiogramme.numeration or antibiogramme.commentaire %}
                                    <div style="padding: 4px 6px; font-size: 8.5px; border-bottom: 1px solid #d1d5db; background-color: #f9fafb;">
                                        {% if antibiogramme.numeration %}<span style="margin-right: 15px;"><strong>Numération :</strong> {{ antibiogramme.numeration }}</span>{% endif %}
                                        {% if antibiogramme.commentaire %}<span><strong>Observation :</strong> {{ antibiogramme.commentaire }}</span>{% endif %}
                                    </div>
                                {% endif %}

                                <table class="data-table" style="border: none; margin-bottom: 0;">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%; border-left: none;">Antibiotique testé</th>
                                            <th style="width: 25%;">Famille</th>
                                            <th style="width: 25%; border-right: none;">Sensibilité</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set hasSaisi = false %}
                                        {% for ligneATB in antibiogramme.lignes %}
                                            {% if ligneATB.sensibilite is not empty %}
                                                {% set hasSaisi = true %}
                                                <tr>
                                                    <td style="border-left: none; padding-left: 12px;">{{ ligneATB.antibiotique.nom }}</td>
                                                    <td>{{ ligneATB.antibiotique.famille|default('-') }}</td>
                                                    <td style="border-right: none;">
                                                        <strong style="
                                                            color: {% if ligneATB.sensibilite == 'S' %}#15803d{% elseif ligneATB.sensibilite == 'R' %}#b91c1c{% else %}#b45309{% endif %};
                                                        ">
                                                            {{ ligneATB.sensibilite }} 
                                                            {% if ligneATB.sensibilite == 'S' %}(Sensible)
                                                            {% elseif ligneATB.sensibilite == 'R' %}(Résistant)
                                                            {% elseif ligneATB.sensibilite == 'I' %}(Intermédiaire)
                                                            {% endif %}
                                                        </strong>
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if not hasSaisi %}
                                            <tr>
                                                <td colspan="3" style="text-align: center; color: #6b7280; font-style: italic; border-left: none; border-right: none;">
                                                    Aucune sensibilité n'a été saisie pour ce germe.
                                                </td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        {% endfor %}
                    {% endif %}
                    {% if resultat and resultat.conclusion %}
                        <div style="margin-top: 10px; padding: 4px 6px; background: #f9fafb; border-left: 2px solid #0f4c81; font-size: 8.5px;">
                            <strong>Note clinique :</strong> {{ resultat.conclusion|nl2br }}
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div style="text-align: center; padding: 20px;" class="text-muted">Aucun résultat validé disponible pour cette consultation.</div>
            {% endfor %}
        </div>

        <div class="footer-note">
            Clinique Médicale Nassarawa — Fin du compte-rendu consolidé biologique.
        </div>
    </div>
</body>
</html>