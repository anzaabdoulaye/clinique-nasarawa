
<!DOCTYPE html>
<html lang="fr">
<head>
{% set patient = patient|default(consultation.dossierMedical.patient|default(consultation.rendezVous.patient|default(null))) %}
    <meta charset="UTF-8">
    <title>Bon d'examen laboratoire - #{{ consultation.id }}</title>
    <style>
        @page { size: A4 portrait; margin: 8mm; }
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 10px; color: #1f2937; margin: 0; padding: 0; }
        .document { width: 100%; border: 1px solid #cfd8e3; border-radius: 8px; padding: 12px; }
        .top-bar { height: 4px; background: #0f4c81; margin-bottom: 10px; border-radius: 4px; }
        table { width: 100%; border-collapse: collapse; }
        td, th { vertical-align: top; }
        
        /* En-tête Institutionnel Standardisé */
        .header-table { border-bottom: 2px solid #0f4c81; padding-bottom: 8px; margin-bottom: 12px; }
        .clinic-title { font-size: 14px; font-weight: bold; color: #0f4c81; margin: 0; }
        .clinic-meta { font-size: 8px; color: #4b5563; line-height: 1.3; }
        .qr-box { border: 1px solid #cfd8e3; border-radius: 6px; padding: 6px; text-align: center; background: #f9fafb; }
        
        /* Blocs d'informations */
        .section-title { background: #0f4c81; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px; margin-top: 12px; margin-bottom: 6px; border-radius: 4px; }
        .info-table td { padding: 3px 0; }
        
        /* Tableaux de données */
        .data-table { width: 100%; margin-top: 8px; }
        .data-table th { background: #f3f4f6; border: 1px solid #d1d5db; padding: 6px; text-align: left; font-weight: bold; }
        .data-table td { border: 1px solid #e5e7eb; padding: 6px; }
        
        .footer-note { text-align: center; margin-top: 30px; font-size: 8px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 8px; }
        .signatures { margin-top: 25px; width: 100%; }
        .signature-block { width: 33%; border: 1px dashed #cfd8e3; padding: 8px; font-size: 9px; min-height: 60px; }
    </style>
</head>
<body>
    <div class="document">
        <div class="top-bar"></div>
        
        <table>
                <tr>
                    <td style="width:15%;">
                        <img src="{{ absolute_url(asset('assets/images/logo2.png')) }}" alt="Logo Clinique" class="clinic-logo">
                    </td>
                    <td style="width:60%;">
                        <div class="clinic">
                            <h1>Clinique Neurologique Nassarawa</h1>
                            <div class="sub">
                                <strong>NIF :</strong> 120402/R | <strong>RCCM :</strong> NE-NIM-01-2024-B12-00145<br>
                                <strong>Adresse :</strong> Yantala Haut, Avenue du Daoura YN 187, Niamey<br>
                                <strong>Tél :</strong> 20 75 51 02 / 82 09 61 12<br>
                                <strong>Email :</strong> nassrawaclinique@gmail.com
                            </div>
                        </div>
                    </td>
                    <td style="width:25%; text-align:right;">
                        </td>
                </tr>
            </table>

        <div class="section-title">INFORMATIONS DU PATIENT ET DE L'EXAMEN</div>
        <table class="info-table">
            <tr>
                <td style="width: 50%;"><strong>Nom et prénom :</strong> {{ patient.nomComplet|default(patient.nom ~ ' ' ~ patient.prenom) }}</td>
                <td style="width: 50%;"><strong>Médecin prescripteur :</strong> {{ medecinNom|default('Non renseigné') }}</td>
            </tr>
            <tr>
                <td><strong>Âge / Sexe :</strong> {{ patient.age }} ans / {{ patient.sexe|default('-') }}</td>
                <td><strong>Date de prescription :</strong> {{ datePrescription|date('d/m/Y H:i') }}</td>
            </tr>{# Remplacez l'ancienne ligne par celle-ci #}

            <tr>
                <td colspan="2"><strong>Consultation :</strong> #{{ consultation.id }}</td>
            </tr>
        </table>

        <div class="section-title">EXAMENS DEMANDÉS</div>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 15%;">Code</th>
                    <th style="width: 55%;">Examen / Analyse demandé</th>
                    <th style="width: 15%; text-align: center;">Quantité</th>
                    <th style="width: 15%;">Service</th>
                </tr>
            </thead>
            <tbody>
                {% for prestation in prestations %}
                    <tr>
                        <td>{{ prestation.tarifPrestation.code }}</td>
                        <td><strong>{{ prestation.tarifPrestation.libelle }}</strong></td>
                        <td style="text-align: center;">{{ prestation.quantite }}</td>
                        <td>{{ prestation.tarifPrestation.serviceExecution|title }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <table class="signatures">
            <tr>
                <td class="signature-block">
                    <div style="font-weight: bold; margin-bottom: 30px;">Cachet & Signature Médecin</div>
                </td>
                <td style="width: 4%;"></td>
                <td class="signature-block">
                    <div style="font-weight: bold; margin-bottom: 30px;">Prélèvement Laboratoire</div>
                </td>
                <td style="width: 4%;"></td>
                <td class="signature-block">
                    <div style="font-weight: bold; margin-bottom: 30px;">Réception / Facturation</div>
                </td>
            </tr>
        </table>

        <div class="footer-note">
            Clinique Médicale Nassarawa — Document informatique imprimé automatiquement.
        </div>
    </div>
</body>
</html>