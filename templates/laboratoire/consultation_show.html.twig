{% extends 'base.html.twig' %}

{% block title %}
    Consultation laboratoire
{% endblock %}

{% block body %}

<div class="container-fluid py-4">

    {# ===================== HEADER ===================== #}

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">

        <div class="card-body p-4">

            <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">

                <div>

                    <div class="d-flex align-items-center gap-2 mb-2">

                        <span class="badge bg-primary-subtle text-primary px-3 py-2">
                            <i class="ri-flask-line me-1"></i>
                            Consultation laboratoire
                        </span>

                        <span class="badge bg-dark-subtle text-dark px-3 py-2">
                            #{{ consultation.id }}
                        </span>

                    </div>

                    <h3 class="fw-bold mb-1">

                        {{ patient.nomComplet|default(
                            (patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim
                        ) }}

                    </h3>

                    <div class="text-muted">

                        {% if patient.code is defined and patient.code %}
                            Code patient : {{ patient.code }}
                        {% endif %}

                    </div>

                </div>

                <div class="text-lg-end">

                    <div class="small text-muted mb-1">
                        Médecin prescripteur
                    </div>

                    <div class="fw-semibold">

                        {{ consultation.medecin.nomComplet|default(
                            (consultation.medecin.nom|default('') ~ ' ' ~ consultation.medecin.prenom|default(''))|trim
                        ) }}

                    </div>

                    <div class="text-muted small mt-2">

                        {{ consultation.createdAt
                            ? consultation.createdAt|date('d/m/Y H:i')
                            : '-'
                        }}

                    </div>

                </div>

            </div>

        </div>

    </div>

    {# ===================== STATS ===================== #}

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total examens
                    </div>

                    <div class="display-6 fw-bold">
                        {{ total }}
                    </div>

                </div>

            </div>

        </div>

        

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        En cours
                    </div>

                    <div class="display-6 fw-bold text-primary">
                        {{ nombreEnCours }}
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Réalisés
                    </div>

                    <div class="display-6 fw-bold text-success">
                        {{ nombreRealises }}
                    </div>

                </div>

            </div>

        </div>

    </div>


    {# ===================== TABLEAU ===================== #}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Examens laboratoire
                    </h5>

                    <div class="text-muted small">
                        Gestion globale des examens de cette consultation
                    </div>

                </div>

               <div class="d-flex gap-2">
                    {# Bouton Tout prendre en charge : Uniquement s'il y a des examens non commencés #}
                    {% if nombrePayes is defined and nombrePayes > 0 %}
                        <form method="post" action="{{ path('app_laboratoire_tout_prendre_en_charge', {id: consultation.id}) }}" onsubmit="return confirm('Voulez-vous vraiment prendre en charge tous les examens en attente ?');">
                            <button type="submit" class="btn btn-warning rounded-pill">
                                <i class="ri-loader-4-line me-1"></i> Tout prendre en charge
                            </button>
                        </form>
                    {% endif %}

                    {# Analyse de l'état des prestations pour déterminer si le dossier est clos #}
                    {% set dossierEnCours = false %}
                    {% for prescription in prestations %}
                        {% if prescription.statut.value == 'paye' or prescription.statut.value == 'en_cours' %}
                            {% set dossierEnCours = true %}
                        {% endif %}
                    {% endfor %}

                    {# Affichage dynamique selon la clôture du dossier #}
                    {% if dossierEnCours %}
                        <form method="post" action="{{ path('app_laboratoire_terminer_consultation', {id: consultation.id}) }}" onsubmit="return confirm('Voulez-vous valider et marquer ce dossier comme terminé ?');">
                            <button type="submit" class="btn btn-success rounded-pill">
                                <i class="ri-checkbox-circle-line me-1"></i> Marquer comme terminé
                            </button>
                        </form>
                    {% else %}
                        {# Le dossier est clos : Le bouton d'impression générale prend la place #}
                        <a href="{{ path('app_laboratoire_resultats_consultation_pdf', { id: consultation.id }) }}" 
                           target="_blank" 
                           class="btn btn-primary rounded-pill">
                            <i class="ri-printer-line me-1"></i> Imprimer tous les résultats
                        </a>
                        
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill d-flex align-items-center">
                            <i class="ri-checkbox-circle-fill me-1"></i> Dossier laboratoire clôturé
                        </span>
                    {% endif %}

                    <a href="{{ path('app_laboratoire_bon_print', { id: consultation.id }) }}" target="_blank" class="btn btn-outline-dark rounded-pill">
                        <i class="ri-printer-line me-1"></i> Imprimer bon
                    </a>
                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">

                    <tr>

                        <th>Examen</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>

                    </tr>

                    </thead>

                    <tbody>

                    {% for prestation in prestations %}

                        {% set statut = prestation.statut.value %}
                        {% set resultat = prestation.resultatLaboratoire %}

                        <tr>

                            <td>

                                <div class="fw-semibold">

                                    {{ prestation.tarifPrestation.libelle }}

                                </div>

                                <div class="small text-muted">

                                    {{ prestation.tarifPrestation.categorie.value|replace({'_':' '})|title }}

                                </div>

                            </td>

                            <td>

                                {% if statut == 'paye' %}

                                    <span class="badge text-bg-warning rounded-pill px-3 py-2">
                                        À traiter
                                    </span>

                                {% elseif statut == 'en_cours' %}

                                    <span class="badge text-bg-primary rounded-pill px-3 py-2">
                                        En cours
                                    </span>

                                {% elseif statut == 'realise' %}

                                    <span class="badge text-bg-success rounded-pill px-3 py-2">
                                        Réalisé
                                    </span>

                                {% endif %}

                            </td>

                            <td>

                                {{ prestation.createdAt
                                    ? prestation.createdAt|date('d/m/Y H:i')
                                    : '-'
                                }}

                            </td>

                            <td class="text-end">

                                <div class="d-flex justify-content-end flex-wrap gap-2">

                                    <a href="{{ path(
                                        'app_laboratoire_show',
                                        {id: prestation.id}
                                    ) }}"
                                       class="btn btn-sm btn-primary rounded-pill">

                                        <i class="ri-test-tube-line me-1"></i>

                                        {% if resultat %}
                                        <a href="{{ path('app_laboratoire_show', {id: prestation.id}) }}" class="btn btn-sm btn-primary rounded-pill">
                                            <i class="ri-edit-line me-1"></i> Modifier
                                        </a>
                                    {% else %}
                                        {# BOUTON MODIFIÉ POUR L'AJAX #}
                                        <button type="button" 
                                                class="btn btn-sm btn-primary rounded-pill js-open-result-modal"
                                                data-url="{{ path('app_laboratoire_resultat_edit', {id: prestation.id}) }}">
                                            <i class="ri-test-tube-line me-1"></i> Saisir
                                        </button>
                                    {% endif %}

                                    </a>

                                    {% if resultat %}

                                        <a href="{{ path(
                                            'app_laboratoire_resultat_print',
                                            {id: prestation.id}
                                        ) }}"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-dark rounded-pill">

                                            <i class="ri-eye-line me-1"></i>
                                            Résultat

                                        </a>

                                    {% endif %}

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    {# Conteneur de la Modale #}
<div class="modal fade" id="resultatModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" id="resultatModalContent">
            {# Le contenu sera injecté ici par AJAX #}
        </div>
    </div>
</div>

</div>

{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const modalEl = document.getElementById('resultatModal');
    if (!modalEl) return;
    
    const modalContent = document.getElementById('resultatModalContent');
    const bsModal = new bootstrap.Modal(modalEl);

    // 1. Ouvrir la modale
    document.querySelectorAll('.js-open-result-modal').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const url = this.dataset.url;
            
            modalContent.innerHTML = `
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <div class="mt-3 fw-semibold text-muted">Chargement du formulaire...</div>
                </div>`;
            bsModal.show();

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(async res => {
                    if (!res.ok) {
                        // Gérer l'erreur "Vous devez d'abord prendre en charge cet examen"
                        const errorHtml = await res.text();
                        modalContent.innerHTML = errorHtml;
                        return;
                    }
                    modalContent.innerHTML = await res.text();
                    initCollection();
                    initFormSubmit(url);
                })
                .catch(err => {
                    modalContent.innerHTML = '<div class="p-4 alert alert-danger m-3">Erreur réseau lors du chargement.</div>';
                });
        });
    });

    // 2. Gestion de l'ajout/suppression de lignes (CollectionType)
    function initCollection() {
        const container = document.getElementById('resultat-lignes');
        if (!container) return;
        
        let index = parseInt(container.dataset.index);

        const addBtn = document.querySelector('.js-add-result-line');
        if (addBtn) {
            addBtn.addEventListener('click', () => {
                let prototype = container.dataset.prototype;
                let newForm = prototype.replace(/__name__/g, index);
                index++;
                container.insertAdjacentHTML('beforeend', newForm);
            });
        }

        container.addEventListener('click', function(e) {
            const removeBtn = e.target.closest('.js-remove-result-line');
            if (removeBtn) {
                removeBtn.closest('.js-result-line-item').remove();
            }
        });
    }

    // 3. Soumission AJAX
    function initFormSubmit(submitUrl) {
        const form = document.getElementById('resultatLaboratoireForm');
        if (!form) return;

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = form.querySelector('.js-submit-resultat');
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Enregistrement...';
            btn.disabled = true;

            fetch(submitUrl, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => {
                const contentType = res.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return res.json().then(data => {
                        if(data.success) {
                            bsModal.hide();
                            window.location.reload(); // Recharge la page pour actualiser la barre de progression et les badges
                        }
                    });
                } else {
                    return res.text().then(html => {
                        modalContent.innerHTML = html;
                        initCollection();
                        initFormSubmit(submitUrl);
                    });
                }
            });
        });
    }
});
</script>
{% endblock %}