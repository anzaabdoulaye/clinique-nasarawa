{% extends 'base.html.twig' %}

{% block title %}
    Consultation laboratoire
{% endblock %}

{% block body %}

<div class="container-fluid py-4">

    {# ===================== HEADER ===================== #}

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">

        <div class="card-body p-4">

            <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">

                <div>

                    <div class="d-flex align-items-center gap-2 mb-2">

                        <span class="badge bg-primary-subtle text-primary px-3 py-2">
                            <i class="ri-flask-line me-1"></i>
                            Consultation laboratoire
                        </span>

                        <span class="badge bg-dark-subtle text-dark px-3 py-2">
                            #{{ consultation.id }}
                        </span>

                    </div>

                    <h3 class="fw-bold mb-1">

                        {{ patient.nomComplet|default(
                            (patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim
                        ) }}

                    </h3>

                    <div class="text-muted">

                        {% if patient.code is defined and patient.code %}
                            Code patient : {{ patient.code }}
                        {% endif %}

                    </div>

                </div>

                <div class="text-lg-end">

                    <div class="small text-muted mb-1">
                        Médecin prescripteur
                    </div>

                    <div class="fw-semibold">

                        {{ consultation.medecin.nomComplet|default(
                            (consultation.medecin.nom|default('') ~ ' ' ~ consultation.medecin.prenom|default(''))|trim
                        ) }}

                    </div>

                    <div class="text-muted small mt-2">

                        {{ consultation.createdAt
                            ? consultation.createdAt|date('d/m/Y H:i')
                            : '-'
                        }}

                    </div>

                </div>

            </div>

        </div>

    </div>

    {# ===================== STATS ===================== #}

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total examens
                    </div>

                    <div class="display-6 fw-bold">
                        {{ total }}
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Payés
                    </div>

                    <div class="display-6 fw-bold text-warning">
                        {{ nombrePayes }}
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        En cours
                    </div>

                    <div class="display-6 fw-bold text-primary">
                        {{ nombreEnCours }}
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Réalisés
                    </div>

                    <div class="display-6 fw-bold text-success">
                        {{ nombreRealises }}
                    </div>

                </div>

            </div>

        </div>

    </div>

    {# ===================== PROGRESSION ===================== #}

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between mb-2">

                <span class="fw-semibold">
                    Progression des examens
                </span>

                <span class="fw-bold">
                    {{ progression }}%
                </span>

            </div>

            <div class="progress" style="height: 10px;">

                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: {{ progression }}%">
                </div>

            </div>

        </div>

    </div>

    {# ===================== TABLEAU ===================== #}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Examens laboratoire
                    </h5>

                    <div class="text-muted small">
                        Gestion globale des examens de cette consultation
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <a href="{{ path('app_laboratoire_bon_print', {
                        id: consultation.id
                    }) }}"
                       target="_blank"
                       class="btn btn-outline-dark rounded-pill">

                        <i class="ri-printer-line me-1"></i>
                        Imprimer bon

                    </a>

                    <a href="{{ path('app_laboratoire_resultats_consultation_pdf', {
                        id: consultation.id
                    }) }}"
                       target="_blank"
                       class="btn btn-success rounded-pill">

                        <i class="ri-file-pdf-line me-1"></i>
                        Résultats PDF

                    </a>

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">

                    <tr>

                        <th>Examen</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>

                    </tr>

                    </thead>

                    <tbody>

                    {% for prestation in prestations %}

                        {% set statut = prestation.statut.value %}
                        {% set resultat = prestation.resultatLaboratoire %}

                        <tr>

                            <td>

                                <div class="fw-semibold">

                                    {{ prestation.tarifPrestation.libelle }}

                                </div>

                                <div class="small text-muted">

                                    {{ prestation.tarifPrestation.categorie.value|replace({'_':' '})|title }}

                                </div>

                            </td>

                            <td>

                                {% if statut == 'paye' %}

                                    <span class="badge text-bg-warning rounded-pill px-3 py-2">
                                        À traiter
                                    </span>

                                {% elseif statut == 'en_cours' %}

                                    <span class="badge text-bg-primary rounded-pill px-3 py-2">
                                        En cours
                                    </span>

                                {% elseif statut == 'realise' %}

                                    <span class="badge text-bg-success rounded-pill px-3 py-2">
                                        Réalisé
                                    </span>

                                {% endif %}

                            </td>

                            <td>

                                {{ prestation.createdAt
                                    ? prestation.createdAt|date('d/m/Y H:i')
                                    : '-'
                                }}

                            </td>

                            <td class="text-end">

                                <div class="d-flex justify-content-end flex-wrap gap-2">

                                    <a href="{{ path(
                                        'app_laboratoire_show',
                                        {id: prestation.id}
                                    ) }}"
                                       class="btn btn-sm btn-primary rounded-pill">

                                        <i class="ri-test-tube-line me-1"></i>

                                        {% if resultat %}
                                            Modifier
                                        {% else %}
                                            Saisir
                                        {% endif %}

                                    </a>

                                    {% if resultat %}

                                        <a href="{{ path(
                                            'app_laboratoire_resultat_print',
                                            {id: prestation.id}
                                        ) }}"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-dark rounded-pill">

                                            <i class="ri-eye-line me-1"></i>
                                            Résultat

                                        </a>

                                    {% endif %}

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

{% endblock %}