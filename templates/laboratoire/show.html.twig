{% extends 'base.html.twig' %}

{% block title %}Examen laboratoire #{{ prestation.id }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {% set consultation = prestation.consultation %}
    {% set rdv = consultation ? consultation.rendezVous|default(null) : null %}
    {% set dossier = consultation ? consultation.dossierMedical|default(null) : null %}
    {% set patient = dossier and dossier.patient is defined and dossier.patient ? dossier.patient : (rdv ? rdv.patient|default(null) : null) %}
    {% set statut = prestation.statut.value %}

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h3 class="mb-1">Examen laboratoire #{{ prestation.id }}</h3>
            <div class="text-muted small">
                {{ prestation.tarifPrestation.libelle }}
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_laboratoire_index') }}" class="btn btn-outline-secondary">
                Retour
            </a>

                        {% if dossier %}
                                <a href="{{ path('app_dossier_medical_show', {'id': dossier.id}) }}"
                                     class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-folder-open me-1"></i> Voir dossier
                                </a>
                        {% endif %}

            {% if consultation and canViewConsultationResultsSheet %}
                <a href="{{ path('app_laboratoire_resultats_consultation_show', {id: consultation.id}) }}"
                   class="btn btn-outline-primary">
                    <i class="ri-file-list-3-line me-1"></i> Fiche consultation
                    {% if consultationResultsCount > 1 %}
                        ({{ consultationResultsCount }})
                    {% endif %}
                </a>
            {% endif %}

            {% if statut == 'paye' %}
                <form method="post" action="{{ path('app_laboratoire_prendre_en_charge', {id: prestation.id}) }}">
                    <button type="submit" class="btn btn-primary">
                        Prendre en charge
                    </button>
                </form>
            {% endif %}

           {% if prestation.resultatLaboratoire %}
                <button type="button"
                        class="btn btn-outline-dark js-open-resultat"
                        data-bs-toggle="modal"
                        data-bs-target="#resultatLaboratoireModal"
                        data-url="{{ path('app_laboratoire_resultat_edit', {id: prestation.id}) }}">
                    Modifier le résultat
                </button>
            {% else %}
                {% if statut == 'en_cours' %}
                    {# Bouton pour déclencher l'ouverture de la modale #}
                    <button type="button" 
                            class="btn btn-primary js-open-result-modal" 
                            data-url="{{ path('app_laboratoire_resultat_edit', {id: prestation.id}) }}">
                        <i class="ri-edit-line me-1"></i> Saisir / Modifier le résultat
                    </button>

                    {# Conteneur de la modale (à placer tout en bas de votre fichier show.html.twig) #}
                    <div class="modal fade" id="resultatModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
                            <div class="modal-content shadow-lg border-0" id="resultatModalContent">
                                {# Le contenu sera injecté ici par AJAX #}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <button class="btn btn-outline-dark" disabled>
                        Saisir le résultat
                    </button>
                {% endif %}
            {% endif %}
            {% if prestation.resultatLaboratoire %}
                <a href="{{ path('app_laboratoire_resultat_pdf', {id: prestation.id}) }}"
                target="_blank"
                class="btn btn-outline-primary">
                    <i class="ri-printer-line me-1"></i> Imprimer le résultat
                </a>
            {% endif %}
            {% if statut in ['paye', 'en_cours'] %}
               {% if prestation.resultatLaboratoire %}
                    <form method="post" action="{{ path('app_laboratoire_realiser', {id: prestation.id}) }}">
                        <button type="submit" class="btn btn-success">
                            Marquer réalisé
                        </button>
                    </form>
                {% else %}
                    <button class="btn btn-success" disabled
                     title="Veuillez d'abord saisir le résultat" >
                        Marquer réalisé
                    </button>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if not canEditResult %}
        <div class="alert alert-warning">
            Vous devez d'abord prendre en charge cet examen avant de saisir le resultat.
        </div>
    {% elseif statut == 'en_cours' and not hasResultatSaisi %}
        <div class="alert alert-info">
            Saisissez le resultat avant de marquer cet examen comme realise.
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Patient</div>
                <div class="card-body">
                    <div><strong>Nom :</strong>
                        {% if patient %}
                            {{ patient.nomComplet|default((patient.nom|default('') ~ ' ' ~ patient.prenom|default(''))|trim) }}
                        {% else %}
                            -
                        {% endif %}
                    </div>
                    <div><strong>Consultation :</strong> #{{ consultation.id }}</div>
                    <div><strong>Rendez-vous :</strong> {{ rdv ? ('#' ~ rdv.id) : '-' }}</div>
                    <div><strong>Sexe :</strong> {{ patient and patient.sexe ? patient.sexe : '-' }}</div>
                    <div><strong>Âge :</strong> {{ patient and patient.dateNaissance ? patient.dateNaissance.diff(date()).y ~ ' ans' : '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Examen</div>
                <div class="card-body">
                    <div><strong>Libellé :</strong> {{ prestation.tarifPrestation.libelle }}</div>
                    <div><strong>Catégorie :</strong> {{ prestation.tarifPrestation.categorie.value|replace({'_':' '})|title }}</div>
                    <div><strong>Quantité :</strong> {{ prestation.quantite }}</div>
                    <div><strong>Service :</strong> {{ prestation.tarifPrestation.serviceExecution ?: '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold">Suivi</div>
                <div class="card-body">
                    <div><strong>Statut :</strong>
                        {% if statut == 'paye' %}
                            <span class="badge bg-success">Payé</span>
                        {% elseif statut == 'en_cours' %}
                            <span class="badge bg-primary">En cours</span>
                        {% elseif statut == 'realise' %}
                            <span class="badge bg-secondary">Réalisé</span>
                        {% else %}
                            <span class="badge bg-dark">{{ statut }}</span>
                        {% endif %}
                    </div>
                    <div class="mt-2"><strong>Date création :</strong> {{ prestation.createdAt ? prestation.createdAt|date('Y-m-d H:i') : '-' }}</div>
                    <div><strong>Dernière mise à jour :</strong> {{ prestation.modifiedAt ? prestation.modifiedAt|date('Y-m-d H:i') : '-' }}</div>
                    <div><strong>Résultat saisi :</strong> {{ hasResultatSaisi ? 'Oui' : 'Non' }}</div>
                    <div><strong>Validé par :</strong> {{ prestation.resultatLaboratoire and prestation.resultatLaboratoire.validePar ? prestation.resultatLaboratoire.validePar : '-' }}</div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white fw-semibold">Instructions médicales</div>
                <div class="card-body">
                    {{ prestation.instructions ?: 'Aucune instruction particulière.' }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="resultatLaboratoireModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow" id="resultatLaboratoireModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 mb-0">Chargement...</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('resultatLaboratoireModal');
            const modalContent = document.getElementById('resultatLaboratoireModalContent');

            function openResultatModal(url) {
                modalContent.innerHTML = `
                    <div class="modal-body text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3 mb-0">Chargement...</p>
                    </div>
                `;

                fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.text())
                .then(html => {
                    modalContent.innerHTML = html;
                    bindResultatForm();
                    bindDynamicResultLines();
                })
                .catch(() => {
                    modalContent.innerHTML = `
                        <div class="modal-body">
                            <div class="alert alert-danger mb-0">
                                Impossible de charger le formulaire de résultat.
                            </div>
                        </div>
                    `;
                });
            }

            function bindDynamicResultLines() {
                const container = modalContent.querySelector('#resultat-lignes');
                const addBtn = modalContent.querySelector('.js-add-result-line');

                if (!container || !addBtn) return;

                addBtn.addEventListener('click', function () {
                    const index = parseInt(container.dataset.index, 10);
                    const prototype = container.dataset.prototype;
                    const newForm = prototype.replace(/__name__/g, index);

                    const wrapper = document.createElement('div');
                    wrapper.className = 'card border mb-3 js-result-line-item';
                    wrapper.innerHTML = `
                        <div class="card-body">
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-outline-danger js-remove-result-line">
                                    <i class="ri-delete-bin-line"></i>
                                </button>
                            </div>
                            <div class="row g-3">
                                ${newForm}
                            </div>
                        </div>
                    `;

                    container.appendChild(wrapper);
                    container.dataset.index = index + 1;

                    bindRemoveButtons();
                });

                bindRemoveButtons();
            }

            function bindRemoveButtons() {
                modalContent.querySelectorAll('.js-remove-result-line').forEach(btn => {
                    btn.onclick = function () {
                        const item = this.closest('.js-result-line-item');
                        if (item) item.remove();
                    };
                });
            }

            function bindResultatForm() {
                const form = modalContent.querySelector('form');
                if (!form) return;

                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const submitBtn = form.querySelector('.js-submit-resultat');
                    if (submitBtn) submitBtn.disabled = true;

                    fetch(form.action, {
                        method: form.method || 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(async response => {
                        const contentType = response.headers.get('content-type') || '';

                        if (contentType.includes('application/json')) {
                            const data = await response.json();

                            if (data.success) {
                                const modal = bootstrap.Modal.getInstance(modalEl);
                                modal?.hide();
                                window.location.reload();
                                return;
                            }
                        }

                        const html = await response.text();
                        modalContent.innerHTML = html;
                        bindResultatForm();
                        bindDynamicResultLines();
                    })
                    .catch(() => {
                        modalContent.innerHTML = `
                            <div class="modal-body">
                                <div class="alert alert-danger mb-0">
                                    Une erreur est survenue pendant l'enregistrement du résultat.
                                </div>
                            </div>
                        `;
                    })
                    .finally(() => {
                        if (submitBtn) submitBtn.disabled = false;
                    });
                });
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.js-open-resultat');
                if (!btn) return;

                const url = btn.dataset.url;
                if (!url) return;

                openResultatModal(url);
            });
        });
    </script>

    <script>
document.addEventListener('DOMContentLoaded', function() {
    const modalEl = document.getElementById('resultatModal');
    if (!modalEl) return;
    
    const modalContent = document.getElementById('resultatModalContent');
    const bsModal = new bootstrap.Modal(modalEl);

    // 1. Ouvrir la modale et charger le formulaire
    document.querySelectorAll('.js-open-result-modal').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const url = this.dataset.url;
            
            // Afficher un loader esthétique
            modalContent.innerHTML = `
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <div class="mt-3 text-muted">Chargement du formulaire de résultat...</div>
                </div>`;
            bsModal.show();

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => res.text())
                .then(html => {
                    modalContent.innerHTML = html;
                    initCollection();
                    initFormSubmit(url);
                })
                .catch(err => {
                    modalContent.innerHTML = '<div class="p-4 alert alert-danger m-3">Une erreur est survenue lors du chargement.</div>';
                });
        });
    });

    // 2. Gestion des lignes dynamiques (CollectionType)
    function initCollection() {
        const container = document.getElementById('resultat-lignes');
        if (!container) return;
        
        let index = parseInt(container.dataset.index);

        // Bouton Ajouter
        const addBtn = document.querySelector('.js-add-result-line');
        if (addBtn) {
            addBtn.addEventListener('click', () => {
                let prototype = container.dataset.prototype;
                let newForm = prototype.replace(/__name__/g, index);
                index++;
                container.insertAdjacentHTML('beforeend', newForm);
                
                // Petit effet visuel
                const newlyAdded = container.lastElementChild;
                newlyAdded.style.opacity = '0';
                newlyAdded.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    newlyAdded.style.transition = 'all 0.3s ease';
                    newlyAdded.style.opacity = '1';
                    newlyAdded.style.transform = 'translateY(0)';
                }, 10);
            });
        }

        // Bouton Supprimer (Délégation d'événement)
        container.addEventListener('click', function(e) {
            const removeBtn = e.target.closest('.js-remove-result-line');
            if (removeBtn) {
                const item = removeBtn.closest('.js-result-line-item');
                item.style.transition = 'all 0.3s ease';
                item.style.opacity = '0';
                item.style.transform = 'translateY(-10px)';
                setTimeout(() => item.remove(), 300);
            }
        });
    }

    // 3. Soumission du formulaire en AJAX
    function initFormSubmit(submitUrl) {
        const form = document.getElementById('resultatLaboratoireForm');
        if (!form) return;

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = form.querySelector('.js-submit-resultat');
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Enregistrement...';
            btn.disabled = true;

            fetch(submitUrl, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => {
                const contentType = res.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return res.json().then(data => {
                        if(data.success) {
                            bsModal.hide();
                            // Recharge la page pour actualiser les badges (En cours -> Réalisé) 
                            // et afficher les boutons d'impression
                            window.location.reload();
                        }
                    });
                } else {
                    // S'il y a des erreurs de validation Symfony, on réaffiche le formulaire avec les erreurs
                    return res.text().then(html => {
                        modalContent.innerHTML = html;
                        initCollection();
                        initFormSubmit(submitUrl);
                    });
                }
            });
        });
    }
});
</script>
{% endblock %}