{# templates/traitement_hospitalisation/_form.html.twig #}

<style>
    .hours-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        background: #f8f9fa;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
    }

    .hours-grid .form-check {
        margin-bottom: 0;
        padding: 8px;
        border-radius: 6px;
        transition: background 0.2s;
        border: 1px solid transparent;
    }

    .hours-grid .form-check:hover {
        background: #e9ecef;
        border-color: #adb5bd;
    }

    .hours-grid label {
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        color: #6b7280;
        letter-spacing: 0.05em;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>
{{ form_start(form, {
    'action': path('app_traitement_hospitalisation_new', {'hospitalisation': hospitalisation.id}),
    'attr': {'class': 'votre-classe-si-besoin'}
}) }}
    {{ form_row(form.description) }}
    {{ form_row(form.dateDebut) }}
    {{ form_row(form.dateFin) }}
    {{ form_row(form.planification) }}

    <div class="mb-3">
        <label class="form-label fw-bold">Planification par jour</label>
        <div id="planification-container" 
             data-date-debut-id="{{ form.dateDebut.vars.id }}" 
             data-date-fin-id="{{ form.dateFin.vars.id }}" 
             data-planification-id="{{ form.planification.vars.id }}"
             class="border rounded p-3 bg-light" style="max-height: 500px; overflow-y: auto;">
            <div class="text-muted">Sélectionnez une date de début et de fin pour générer le tableau.</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
{{ form_end(form) }}

<style>
    .hour-check {
        font-size: 11px;
        padding: 2px 0 !important;
    }
    .hour-checkbox {
        transform: scale(0.9);
        cursor: pointer;
    }
    .table-sm td, .table-sm th {
        padding: 4px 2px;
        vertical-align: middle;
    }
</style>