    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateActe</th>
                <th>NomPatient</th>
                <th>LibelleActe</th>
                <th>MontantTotal</th>
                <th>TauxReversement</th>
                <th>MontantBrutMedecin</th>
