                <td>{{ honoraire_medecin.tauxReversement }}</td>
                <td>{{ honoraire_medecin.montantBrutMedecin }}</td>
                <td>{{ honoraire_medecin.montantIsb }}</td>
                <td>{{ honoraire_medecin.montantNetAPayer }}</td>
