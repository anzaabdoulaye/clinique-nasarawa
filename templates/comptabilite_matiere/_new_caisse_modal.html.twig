<div class="modal fade" id="newCaisseModal" tabindex="-1" aria-labelledby="newCaisseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            {{ form_start(caisseForm, {'action': path('app_hub_caisse_new')}) }}
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <div>
                        <h4 class="modal-title fw-bold text-dark" id="newCaisseModalLabel">
                            <i class="ri-safe-2-line me-2 text-warning"></i>
                            Nouvelle opération de caisse
                        </h4>
                        <p class="text-muted mb-0 mt-1">
                            Enregistrer un mouvement financier dans le journal.
                        </p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    {{ form_widget(caisseForm) }}
                </div>

                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        Annuler
                    </button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark">
                        <i class="ri-save-line me-1"></i>
                        Ajouter au journal
                    </button>
                </div>
            {{ form_end(caisseForm) }}
        </div>
    </div>
</div>