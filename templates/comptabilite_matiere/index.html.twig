{% extends 'base.html.twig' %}

{% block title %}Hub Comptabilité & Gestion{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# ===== En-tête de page global ===== #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="ri-briefcase-4-line me-2 text-primary"></i>
                Comptabilité & Gestion
            </h2>
            <p class="text-muted mb-0">
                Gérez vos stocks, la paie du personnel/praticiens et le journal de caisse depuis un seul espace.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary shadow-sm" href="{{ path('app_comptabilite_matiere_dashboard') }}">
                <i class="ri-bar-chart-box-line me-1"></i>
                Tableau de bord global
            </a>
        </div>
    </div>

    {# ===== Navigation par onglets (Pills) ===== #}
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border" id="comptaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-semibold" id="matiere-tab" data-bs-toggle="pill" data-bs-target="#matiere" type="button" role="tab" aria-controls="matiere" aria-selected="true">
                <i class="ri-archive-drawer-line me-2"></i> Stocks & Bons (Matière)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold" id="paie-tab" data-bs-toggle="pill" data-bs-target="#paie" type="button" role="tab" aria-controls="paie" aria-selected="false">
                <i class="ri-user-heart-line me-2"></i> Personnel, Praticiens & Paie
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold" id="caisse-tab" data-bs-toggle="pill" data-bs-target="#caisse" type="button" role="tab" aria-controls="caisse" aria-selected="false">
                <i class="ri-safe-2-line me-2"></i> Journal de Caisse & Frais
            </button>
        </li>
    </ul>

    {# ===== Contenu des onglets ===== #}
    <div class="tab-content" id="comptaTabsContent">

        {# --------------------------------------------------------- #}
        {# ONGLET 1 : COMPTABILITÉ MATIÈRE (Votre code actuel)       #}
        {# --------------------------------------------------------- #}
        <div class="tab-pane fade show active" id="matiere" role="tabpanel" aria-labelledby="matiere-tab">
            
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary shadow-sm rounded-pill px-4" type="button" data-bs-toggle="modal" data-bs-target="#newBonMatiereModal">
                    <i class="ri-add-line me-1"></i> Nouveau bon
                </button>
            </div>

            {# Vos Cartes synthèse actuelles #}
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted d-block mb-1">Total des bons</small>
                                    <h3 class="fw-bold mb-0 text-dark">{{ bons|length }}</h3>
                                </div>
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex justify-content-center align-items-center" style="width: 52px; height: 52px;">
                                    <i class="ri-file-list-3-line fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% set entrees = 0 %}
                {% set sortiesDef = 0 %}
                {% set sortiesProv = 0 %}
                {% for bon in bons %}
                    {% if bon.type.value == 'ENTREE' %}
                        {% set entrees = entrees + 1 %}
                    {% elseif bon.type.value == 'SORTIE_DEFINITIVE' %}
                        {% set sortiesDef = sortiesDef + 1 %}
                    {% elseif bon.type.value == 'SORTIE_PROVISOIRE' %}
                        {% set sortiesProv = sortiesProv + 1 %}
                    {% endif %}
                {% endfor %}

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted d-block mb-1">Entrées</small>
                                    <h3 class="fw-bold mb-0 text-success">{{ entrees }}</h3>
                                </div>
                                <div class="rounded-circle bg-success-subtle text-success d-flex justify-content-center align-items-center" style="width: 52px; height: 52px;">
                                    <i class="ri-arrow-left-down-line fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted d-block mb-1">Sorties définitives</small>
                                    <h3 class="fw-bold mb-0 text-danger">{{ sortiesDef }}</h3>
                                </div>
                                <div class="rounded-circle bg-danger-subtle text-danger d-flex justify-content-center align-items-center" style="width: 52px; height: 52px;">
                                    <i class="ri-arrow-right-up-line fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted d-block mb-1">Sorties provisoires</small>
                                    <h3 class="fw-bold mb-0 text-warning">{{ sortiesProv }}</h3>
                                </div>
                                <div class="rounded-circle bg-warning-subtle text-warning d-flex justify-content-center align-items-center" style="width: 52px; height: 52px;">
                                    <i class="ri-external-link-line fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Votre Tableau principal des bons #}
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 pb-3 px-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <h5 class="mb-1 fw-semibold text-dark">Liste des bons matière</h5>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <select id="periodeFilter" class="form-select form-select-sm" style="width: auto; min-width: 180px;">
                                <option value="recent" {% if periodeFilter == 'recent' %}selected{% endif %}>30 derniers jours</option>
                                <option value="month" {% if periodeFilter == 'month' %}selected{% endif %}>Ce mois</option>
                                <option value="all" {% if periodeFilter == 'all' %}selected{% endif %}>Tous les bons</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4 pb-4">
                    {% if bons|length > 0 %}
                        <div class="table-responsive">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>N° bon</th>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Motif</th>
                                        <th>Statut</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for bon in bons %}
                                        <tr>
                                            <td><span class="badge bg-light text-dark border">{{ bon.numero }}</span></td>
                                            <td>{{ bon.dateBon|date('d/m/Y') }}</td>
                                            <td>{{ bon.type.value }}</td>
                                            <td>{{ bon.motif.value }}</td>
                                            <td>{{ bon.statut.value }}</td>
                                            <td class="text-center">
                                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3" href="{{ path('app_comptabilite_matiere_show', {'id': bon.id}) }}">Voir</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <p class="text-muted">Aucun bon matière enregistré</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# --------------------------------------------------------- #}
        {# ONGLET 2 : PERSONNEL, PRATICIENS & PAIE                   #}
        {# --------------------------------------------------------- #}
        <div class="tab-pane fade" id="paie" role="tabpanel" aria-labelledby="paie-tab">
    <div class="row g-4">
        {# Colonne Médecins #}
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold text-dark">Médecins</h5>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newMedecinModal">
                        <i class="ri-add-line"></i> Ajouter
                    </button>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nom</th>
                                    <th>Spécialité</th>
                                    <th>ISB (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for m in medecins %}
                                    <tr>
                                        <td class="fw-semibold">{{ m.nomComplet }}</td>
                                        <td><span class="badge bg-light text-dark">{{ m.specialite }}</span></td>
                                        <td>{{ m.tauxIsbDefaut * 100 }} %</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="3" class="text-center text-muted">Aucun médecin enregistré.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {# Colonne Honoraires #}
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold text-dark">Honoraires (Net à payer)</h5>
                    <button class="btn btn-sm btn-success text-white rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newHonoraireModal">
                        <i class="ri-add-line"></i> Saisir honoraires
                    </button>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Médecin</th>
                                    <th>Brut</th>
                                    <th>ISB Retenu</th>
                                    <th>Net à payer</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for h in honoraires %}
                                    <tr>
                                        <td class="fw-semibold">{{ h.medecin.nomComplet }}</td>
                                        <td>{{ h.montantBrutMedecin|number_format(0, ',', ' ') }} FCFA</td>
                                        <td class="text-danger">- {{ h.montantIsb|number_format(0, ',', ' ') }} FCFA</td>
                                        <td class="fw-bold text-success">{{ h.montantNetAPayer|number_format(0, ',', ' ') }} FCFA</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-center text-muted">Aucun honoraire saisi.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

        {# --------------------------------------------------------- #}
        {# ONGLET 3 : CAISSE & FRAIS GÉNÉRAUX                        #}
        {# --------------------------------------------------------- #}
        <div class="tab-pane fade" id="caisse" role="tabpanel" aria-labelledby="caisse-tab">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold text-dark">Opérations de Caisse</h5>
            <button class="btn btn-warning rounded-pill px-4 fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#newCaisseModal">
                <i class="ri-add-line me-1"></i> Nouvelle opération
            </button>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Libellé / Motif</th>
                            <th>Type</th>
                            <th>Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in journalCaisses %}
                            <tr>
                                <td>{{ c.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="fw-semibold">{{ c.libelle }}</td>
                                <td>
                                    {# Vous ajusterez selon les champs réels de votre entité JournalCaisse #}
                                    <span class="badge bg-light text-dark">{{ c.typeOperation | default('Opération') }}</span>
                                </td>
                                <td class="fw-bold">{{ c.montant|number_format(0, ',', ' ') }} FCFA</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-center text-muted py-4">Aucune opération dans le journal.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    </div>
</div>

{{ include('comptabilite_matiere/_new_modal.html.twig') }}
{{ include('comptabilite_matiere/_new_modal.html.twig') }}
{{ include('comptabilite_matiere/_new_medecin_modal.html.twig') }}
{{ include('comptabilite_matiere/_new_honoraire_modal.html.twig') }}
{{ include('comptabilite_matiere/_new_caisse_modal.html.twig') }}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    // Gestionnaire pour le filtre de période
    document.getElementById('periodeFilter').addEventListener('change', function() {
        const selectedValue = this.value;
        const url = new URL(window.location);
        if (selectedValue && selectedValue !== 'all') {
            url.searchParams.set('periode', selectedValue);
        } else {
            url.searchParams.set('periode', 'all');
        }
        window.location.href = url.toString();
    });

    // Mémoriser l'onglet actif après un rechargement de page
    const triggerTabList = document.querySelectorAll('#comptaTabs button[data-bs-toggle="pill"]');
    triggerTabList.forEach(triggerEl => {
        triggerEl.addEventListener('shown.bs.tab', event => {
            localStorage.setItem('activeComptaTab', event.target.id);
        });
    });

    const activeTab = localStorage.getItem('activeComptaTab');
    if (activeTab) {
        const tab = new bootstrap.Tab(document.getElementById(activeTab));
        tab.show();
    }
})();
</script>
{% endblock %}