
{% extends 'base.html.twig' %}

{% block title %}Dossier médical {{ dossier.numeroDossier }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="mb-1">
                        {{ patient.nom }} {{ patient.prenom }}
                    </h2>
                    <div class="text-muted">
                        Dossier : <strong>{{ dossier.numeroDossier }}</strong>
                        {% if patient.code %}
                            | Code patient : <strong>{{ patient.code }}</strong>
                        {% endif %}
                    </div>
                    <div class="mt-2 text-muted">
                        Sexe : {{ patient.sexe ?? '-' }}
                        {% if patient.dateNaissance %}
                            | Né(e) le : {{ patient.dateNaissance|date('d/m/Y') }}
                        {% endif %}
                        | Téléphone : {{ patient.telephone ?? '-' }}
                    </div>
                    <div class="mt-1 text-muted">
                        Adresse : {{ patient.adresse ?? '-' }}
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_dossier_medical_edit', {'id': dossier.id}) }}"
                       class="btn btn-outline-primary">
                        Modifier le dossier
                    </a>
                    {% endif %}
                    {% if dossier.patient and dossier.patient.dossierMedical %}
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newConsultationModal" data-dossier-id="{{ dossier.id }}">
                            Nouvelle consultation
                        </button>
                    {% endif %}
                </div>
                
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Consultations</div>
                    <div class="fs-3 fw-bold">{{ consultations|length }}</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Hospitalisations</div>
                    <div class="fs-3 fw-bold">{{ hospitalisations|length }}</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Dernière consultation</div>
                    <div class="fw-semibold">
                        {{ derniereConsultation ? derniereConsultation.createdAt|date('d/m/Y H:i') : '-' }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Dernière hospitalisation</div>
                    <div class="fw-semibold">
                        {{ derniereHospitalisation ? derniereHospitalisation.createdAt|date('d/m/Y H:i') : '-' }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Résumé médical</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="fw-semibold">Groupe sanguin</div>
                        <div class="text-muted">{{ dossier.groupeSanguin ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Allergies</div>
                        <div class="text-muted">{{ dossier.allergies ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Antécédents médicaux</div>
                        <div class="text-muted">{{ dossier.antecedentsMedicaux ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Antécédents chirurgicaux</div>
                        <div class="text-muted">{{ dossier.antecedentsChirurgicaux ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Maladies chroniques</div>
                        <div class="text-muted">{{ dossier.maladiesChroniques ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Traitement en cours</div>
                        <div class="text-muted">{{ dossier.traitementEnCours ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Handicap</div>
                        <div class="text-muted">{{ dossier.handicap ?: '-' }}</div>
                    </div>

                    <div class="mb-3">
                        <div class="fw-semibold">Grossesse</div>
                        <div class="text-muted">
                            {% if dossier.grossesse is same as(true) %}
                                Oui
                            {% elseif dossier.grossesse is same as(false) %}
                                Non
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
        
            {# --- DÉBUT : CARTE TIMELINE DES OBSERVATIONS --- #}
            <div class="card border-0 shadow-sm rounded-4 mb-4 border-top border-4 border-primary">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-stream me-2"></i> Fil d'actualité médical
                    </h5>
                    {% if is_granted('ROLE_MEDECIN') or is_granted('ROLE_ADMIN') %}
                        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseObservationForm" aria-expanded="false" aria-controls="collapseObservationForm">
                            <i class="fas fa-plus me-1"></i> Ajouter une note
                        </button>
                    {% endif %}
                </div>
                
                <div class="card-body">
                    {# Formulaire d'ajout (Caché par défaut via Collapse) #}
                    <div class="collapse mb-4" id="collapseObservationForm">
                        <div class="card card-body bg-light border-0 shadow-sm">
                            <h6 class="fw-bold mb-3">Nouvelle observation</h6>
                            {{ form_start(formObservation) }}
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        {{ form_row(formObservation.typeObservation) }}
                                    </div>
                                    <div class="col-md-8">
                                        {{ form_row(formObservation.contenu) }}
                                    </div>
                                    <div class="col-12 text-end mt-3">
                                        <button type="submit" class="btn btn-success fw-bold">
                                            <i class="fas fa-save me-1"></i> Enregistrer
                                        </button>
                                    </div>
                                </div>
                            {{ form_end(formObservation) }}
                        </div>
                    </div>

                    {# Affichage de la TimeLine #}
                    <div class="timeline-container mt-2">
                        {% if dossier.observations is empty %}
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-folder-open fs-2 mb-2 opacity-50"></i>
                                <p class="mb-0">Aucune observation n'a encore été ajoutée à ce dossier.</p>
                            </div>
                        {% else %}
                            <div class="position-relative ps-4 border-start border-2 border-primary border-opacity-25 ms-2">
                                {% for observation in dossier.observations|sort((a, b) => b.createdAt <=> a.createdAt) %}
                                    <div class="mb-4 position-relative">
                                        {# Point sur la ligne du temps #}
                                        <div class="position-absolute bg-primary rounded-circle" style="width: 14px; height: 14px; left: -32px; top: 5px; border: 3px solid white; box-shadow: 0 0 0 1px var(--bs-primary);"></div>
                                        
                                        <div class="card border-0 bg-light shadow-sm">
                                            <div class="card-body p-3">
                                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                                    <div>
                                                        <span class="badge bg-primary">{{ observation.typeObservation }}</span>
                                                        {% if observation.hospitalisation %}
                                                            <a href="{{ path('app_hospitalisation_show', {'id': observation.hospitalisation.id}) }}" class="badge bg-warning text-dark text-decoration-none ms-1">
                                                                <i class="fas fa-bed"></i> En Hospitalisation #{{ observation.hospitalisation.id }}
                                                            </a>
                                                        {% endif %}
                                                    </div>
                                                    <small class="text-muted fw-semibold">
                                                        <i class="fas fa-clock me-1"></i> {{ observation.createdAt|date('d/m/Y à H:i') }}
                                                    </small>
                                                </div>
                                                
                                                <p class="mb-2 text-dark" style="white-space: pre-line;">{{ observation.contenu }}</p>
                                                
                                                <div class="text-end border-top pt-2 mt-2">
                                                    <small class="text-muted fw-bold">
                                                        <i class="fas fa-user-md me-1"></i> Dr. {{ observation.medecinAuteur.nom }} {{ observation.medecinAuteur.prenom }}
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
            {# --- FIN : CARTE TIMELINE DES OBSERVATIONS --- #}

            {# Ton ancienne carte "Historique des consultations" commence ici... #}

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Historique des consultations</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0 datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Médecin</th>
                                    <th>Motif</th>
                                    <th>Diagnostic</th>
                                    
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for consultation in consultations %}
                                <tr>
                                    <td>#{{ consultation.id }}</td>
                                    <td>{{ consultation.createdAt ? consultation.createdAt|date('d/m/Y H:i') : '-' }}</td>
                                    <td>
                                        {% if consultation.medecin %}
                                            {{ consultation.medecin.nomComplet|default((consultation.medecin.nom|default('') ~ ' ' ~ consultation.medecin.prenom|default(''))|trim) }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>{{ consultation.motifs ?: '-' }}</td>
                                    <td>{{ consultation.diagnostic ?: '-' }}</td>
                                    
                                    <td class="text-end">
                                        <a href="{{ path('app_consultation_show', {'id': consultation.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Historique des hospitalisations</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0 datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Motif</th>
                                    {# <th>Statut</th> #}
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for hospitalisation in hospitalisations %}
                                <tr>
                                    <td>#{{ hospitalisation.id }}</td>
                                    <td>{{ hospitalisation.createdAt ? hospitalisation.createdAt|date('d/m/Y H:i') : '-' }}</td>
                                    <td>{{ hospitalisation.motifAdmission ?: '-' }}</td>
                                    {# <td>
                                        <span class="badge bg-info text-dark">
                                            {{ hospitalisation.statut.value ?? '-' }}
                                        </span>
                                    </td> #}
                                    <td class="text-end">
                                        <a href="{{ path('app_hospitalisation_show', {'id': hospitalisation.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal Nouvelle Consultation -->
<div class="modal fade" id="newConsultationModal" tabindex="-1" aria-labelledby="newConsultationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newConsultationModalLabel">Nouvelle consultation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="consultationFormContainer">
                    <!-- Le formulaire sera chargé ici via AJAX -->
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('newConsultationModal');
    const formContainer = document.getElementById('consultationFormContainer');

    modal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const dossierId = button.getAttribute('data-dossier-id');

        // Charger le formulaire via AJAX
        const url = `/consultation/new-modal/${dossierId}`;
        fetch(url, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            formContainer.innerHTML = html;
        })
        .catch(error => {
            console.error('Erreur lors du chargement du formulaire:', error);
            formContainer.innerHTML = '<div class="alert alert-danger">Erreur lors du chargement du formulaire.</div>';
        });
    });

    // Réinitialiser le modal quand il se ferme
    modal.addEventListener('hidden.bs.modal', function() {
        formContainer.innerHTML = `
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
        `;
    });
});
</script>
{% endblock %}